\citation{pedrinaci_semantic_2008}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Enrichment effect $\Delta $ (pp) per method and mode. Agentic Tools gains most in SA and DY ($+12.5$, $+15.0$\,pp); Graph gains most in OOS ($+20.0$\,pp); Embedding degrades on DY ($-3.8$\,pp).}}{9}{figure.caption.11}\protected@file@percent }
\newlabel{fig:delta-heatmap}{{6}{9}{Enrichment effect $\Delta $ (pp) per method and mode. Agentic Tools gains most in SA and DY ($+12.5$, $+15.0$\,pp); Graph gains most in OOS ($+20.0$\,pp); Embedding degrades on DY ($-3.8$\,pp)}{figure.caption.11}{}}
\@writefile{toc}{\contentsline {section}{\numberline {5}Discussion}{9}{section.5}\protected@file@percent }
\newlabel{sec:discussion}{{5}{9}{Discussion}{section.5}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces Cost--precision trade-off on Dynamic under enrichment: average tokens per case (log scale) versus R@1. Embedding is near-free ($\sim $1k tokens) at 28.7\% R@1; Agentic Hybrid reaches the highest precision (45.0\%) at moderate cost; Agentic Raw is the most expensive yet weakest.}}{10}{figure.caption.12}\protected@file@percent }
\newlabel{fig:pareto}{{7}{10}{Cost--precision trade-off on Dynamic under enrichment: average tokens per case (log scale) versus R@1. Embedding is near-free ($\sim $1k tokens) at 28.7\% R@1; Agentic Hybrid reaches the highest precision (45.0\%) at moderate cost; Agentic Raw is the most expensive yet weakest}{figure.caption.12}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces Token efficiency: R@1 per 1{,}000 tokens on Dynamic under enrichment. Embedding is more than an order of magnitude more cost-efficient than any other method, since it reaches competitive precision at $\sim $1k tokens. The agentic methods (Agentic Tools, Agentic Raw) buy precision at a steep token cost, and the Agentic Hybrid composite sits in between.}}{10}{figure.caption.13}\protected@file@percent }
\newlabel{fig:token-eff}{{8}{10}{Token efficiency: R@1 per 1{,}000 tokens on Dynamic under enrichment. Embedding is more than an order of magnitude more cost-efficient than any other method, since it reaches competitive precision at $\sim $1k tokens. The agentic methods (Agentic Tools, Agentic Raw) buy precision at a steep token cost, and the Agentic Hybrid composite sits in between}{figure.caption.13}{}}
