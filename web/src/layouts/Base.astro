---
const { title, subtitle, hero = false } = Astro.props;
const base = import.meta.env.BASE_URL;
const navItems = [
  { href: "architecture", label: "Architecture" },
  { href: "results", label: "Results" },
];
const pathAfterBase = Astro.url.pathname.replace(base, "").replace(/^\/+|\/+$/g, "");
const firstSegment = pathAfterBase.split("/")[0] ?? "";
const here = firstSegment;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&family=Source+Serif+Pro:wght@400;600;700&display=swap"
    />
  </head>
  <body class="bg-paper text-ink font-sans antialiased">
    <header class="border-b border-rule bg-white/60 backdrop-blur sticky top-0 z-10">
      <div class="mx-auto max-w-5xl px-6 py-5 flex items-baseline justify-between">
        <a href={base} class="font-serif text-xl font-semibold tracking-tight">
          <span class="text-accent">Semantic</span>-Retrieval
        </a>
        <nav class="flex gap-6 text-sm items-center">
          {
            navItems.map((n) => (
              <a
                href={`${base}${n.href}/`}
                class={
                  "transition relative " +
                  (here === n.href
                    ? "text-ink font-medium after:absolute after:left-0 after:right-0 after:-bottom-2 after:h-0.5 after:bg-accent"
                    : "text-ink-muted hover:text-ink")
                }
              >
                {n.label}
              </a>
            ))
          }
          <a
            href="https://github.com/semantic-retrieval/semantic-retrieval"
            target="_blank"
            rel="noopener noreferrer"
            class="text-ink-subtle hover:text-ink transition ml-2"
            title="GitHub Repository"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
            </svg>
          </a>
        </nav>
      </div>
    </header>

    {
      hero && title ? (
        <section class="border-b border-rule bg-gradient-to-b from-accent-soft/50 to-paper">
          <div class="mx-auto max-w-5xl px-6 py-20 text-center">
            <h1 class="font-serif text-5xl font-semibold tracking-tight leading-tight">
              {title}
            </h1>
            {subtitle && (
              <p class="mt-5 text-ink-muted text-lg max-w-2xl mx-auto leading-relaxed">
                {subtitle}
              </p>
            )}
          </div>
        </section>
      ) : (
        <main class="mx-auto max-w-5xl px-6 py-10">
          {title && (
            <header class="mb-10">
              <h1 class="font-serif text-3xl font-semibold tracking-tight">
                {title}
              </h1>
              {subtitle && (
                <p class="mt-2 text-ink-muted text-base max-w-2xl">
                  {subtitle}
                </p>
              )}
            </header>
          )}
          <slot />
        </main>
      )
    }
    {
      hero && (
        <main class="mx-auto max-w-5xl px-6 py-14">
          <slot />
        </main>
      )
    }

    <footer class="border-t border-rule mt-20">
      <div class="mx-auto max-w-5xl px-6 py-6 text-xs text-ink-subtle flex justify-between">
        <span>
          Results Browser — Semantic Retrieval for the thesis
          <em>Semantically-Grounded Agent Orchestration</em>
        </span>
        <span>Dominik Neumaier · 2026</span>
      </div>
    </footer>
  </body>
</html>
