<section class="mb-14">
  <h2 class="font-serif text-2xl font-semibold mb-2">System Prompts</h2>
  <p class="text-sm text-ink-muted mb-6">Every LLM call in the pipeline has a fixed system prompt. Click a component to expand its prompt(s).</p>

  <div class="space-y-3">
    {Object.entries(PROMPTS).map(([key, comp]) => (
      <div class="border border-rule rounded-xl overflow-hidden">
        <button
          class="prompt-toggle w-full flex items-center justify-between px-5 py-3.5 bg-paper hover:bg-rule/30 transition text-left"
        >
          <div class="flex items-center gap-3">
            <span class="font-mono text-[10px] text-ink-subtle prompt-arrow">▸</span>
            <span class="font-serif text-base font-semibold">{comp.label}</span>
            <span class="text-[10px] font-mono text-ink-subtle">{comp.prompts.length} prompt{comp.prompts.length > 1 ? "s" : ""}</span>
          </div>
          <a href={`https://github.tools.sap/I750252/MasterThesis/blob/main/${comp.file}`}
             target="_blank"
             class="text-[10px] font-mono text-ink-subtle hover:text-accent transition"
             onclick="event.stopPropagation()">
            {comp.file.split("/").pop()} ↗
          </a>
        </button>
        <div class="prompt-panel hidden border-t border-rule divide-y divide-rule">
          {comp.prompts.map(p => (
            <div class="p-5">
              <div class="font-mono text-[10px] uppercase tracking-widest text-ink-subtle mb-3">{p.name}</div>
              <pre class="text-[11px] font-mono text-ink leading-relaxed bg-white rounded-lg p-4 border border-rule overflow-x-auto whitespace-pre-wrap">{p.content}</pre>
            </div>
          ))}
        </div>
      </div>
    ))}
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>(".prompt-toggle").forEach((btn) => {
    btn.addEventListener("click", () => {
      const panel = btn.nextElementSibling as HTMLElement;
      const arrow = btn.querySelector(".prompt-arrow")!;
      const isOpen = !panel.classList.contains("hidden");
      panel.classList.toggle("hidden", isOpen);
      arrow.textContent = isOpen ? "▸" : "▾";
    });
  });

  // ── Interactive Orchestration Flow ──────────────────────────────────
  const FLOW_CONFIGS = {
    single: {
      active: ["flow-user","flow-resolver","flow-decomposer","flow-step-adhoc","flow-retrieval","flow-output"],
      dim: ["flow-planner","flow-step-skill","flow-step-gap","flow-step-refuse"],
      branches: ["flow-branch-dynamic"],
      status: "Decomposer detects single-intent → passes original prompt unchanged → 1 adhoc step → Retrieval",
    },
    multi: {
      active: ["flow-user","flow-resolver","flow-decomposer","flow-step-adhoc","flow-retrieval","flow-output"],
      dim: ["flow-planner","flow-step-skill","flow-step-gap","flow-step-refuse"],
      branches: ["flow-branch-dynamic"],
      status: "Decomposer detects multi-intent → splits into N sub-queries → N adhoc steps → N Retrieval calls",
    },
    skill: {
      active: ["flow-user","flow-resolver","flow-planner","flow-step-skill","flow-output"],
      dim: ["flow-decomposer","flow-step-gap","flow-step-adhoc","flow-step-refuse","flow-retrieval"],
      branches: ["flow-branch-skill"],
      status: "Skill matched → Planner (full coverage) → skill steps with pinned ord_confirmed → no retrieval needed",
    },
    sa: {
      active: ["flow-user","flow-resolver","flow-planner","flow-step-skill","flow-step-gap","flow-retrieval","flow-output"],
      dim: ["flow-decomposer","flow-step-adhoc","flow-step-refuse"],
      branches: ["flow-branch-skill"],
      status: "Skill matched → Planner (partial) → skill steps (pinned) + gap steps → Retrieval for gap steps only",
    },
    oos: {
      active: ["flow-user","flow-resolver","flow-decomposer","flow-step-refuse","flow-output"],
      dim: ["flow-planner","flow-step-skill","flow-step-gap","flow-step-adhoc","flow-retrieval"],
      branches: ["flow-branch-dynamic"],
      status: "Decomposer → OOS detected → D/E: refuse() · A/B/C/S: return top-k anyway (cannot refuse)",
    },
  };

  const ACTIVE_CLASS   = "!border-accent !bg-accent-soft/30 shadow-sm";
  const DIM_CLASS      = "opacity-20";
  const BRANCH_ACTIVE  = "!opacity-100 font-bold text-accent";

  let activeBtn: HTMLElement | null = null;

  document.querySelectorAll<HTMLElement>("[data-flow-input]").forEach(btn => {
    btn.addEventListener("click", () => {
      const key = btn.dataset.flowInput!;
      const cfg = FLOW_CONFIGS[key];
      if (!cfg) return;

      // Reset all nodes
      document.querySelectorAll<HTMLElement>(".flow-node").forEach(n => {
        n.classList.remove(...ACTIVE_CLASS.split(" "), ...DIM_CLASS.split(" "));
      });
      document.querySelectorAll<HTMLElement>(".flow-branch").forEach(n => {
        n.classList.remove(...BRANCH_ACTIVE.split(" "));
        n.classList.add("opacity-30");
      });

      // Apply active
      cfg.active.forEach(id => {
        document.getElementById(id)?.classList.add(...ACTIVE_CLASS.split(" "));
      });
      cfg.dim.forEach(id => {
        document.getElementById(id)?.classList.add(...DIM_CLASS.split(" "));
      });
      cfg.branches.forEach(id => {
        const el = document.getElementById(id);
        el?.classList.remove("opacity-30");
        el?.classList.add(...BRANCH_ACTIVE.split(" "));
      });

      // Status
      const status = document.getElementById("flow-status");
      if (status) status.textContent = cfg.status;

      // Button highlight
      if (activeBtn) activeBtn.classList.remove("ring-2","ring-accent");
      btn.classList.add("ring-2","ring-accent");
      activeBtn = btn;
    });
  });
</script>

