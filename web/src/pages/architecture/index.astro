        <div class="flex items-center gap-2 mb-1">
          <span class="arch-icon text-teal-600">📋</span>
          <span class="font-medium text-sm">Skill Registry</span>
          <code class="text-[10px] font-mono text-ink-subtle ml-auto">skill_registry.py</code>
        </div>
        <div class="text-xs text-ink-subtle">12 SKILL.md files · process-pinned ORD steps</div>
      </a>

      <!-- DT Results box -->
      <div class="mt-4 rounded-lg bg-accent-soft/30 border border-accent/20 p-3 text-xs text-ink-muted font-mono">
        results/design-time/ → summary.json · by_process.json · traces/
      </div>
    </div>

    <!-- ── Run-Time column ── -->
    <div class="bg-white p-6">
      <div class="font-mono text-[10px] uppercase tracking-widest text-accent mb-5">Run-Time</div>

      <!-- Test Cases -->
      <a href="#rt-cases" class="arch-node group block border border-rule rounded-lg p-4 mb-3 hover:border-accent hover:shadow-sm transition cursor-pointer bg-paper">
        <div class="flex items-center gap-2 mb-1">
          <span class="arch-icon">🧪</span>
          <span class="font-medium text-sm">Test Cases</span>
        </div>
        <div class="text-xs text-ink-subtle">30 SG · 20 SA · 40 DY · 10 OOS = 100 runtime cases</div>
      </a>

      <!-- arrow -->
      <div class="flex justify-center my-1 text-ink-subtle text-xl">↓</div>

      <!-- RT Planner pipeline -->
      <a href="#rt-pipeline" class="arch-node group block border border-rule rounded-lg p-4 mb-3 hover:border-accent hover:shadow-sm transition cursor-pointer bg-paper">
        <div class="flex items-center gap-2 mb-2">
          <span class="arch-icon text-accent">🧠</span>
          <span class="font-medium text-sm">Orchestration Pipeline</span>
          <code class="text-[10px] font-mono text-ink-subtle ml-auto">rt_planner.py</code>
        </div>
        <!-- 3-stage mini flow -->
        <div class="flex items-center gap-1 text-[10px] font-mono text-ink-subtle flex-wrap">
          <span class="bg-teal-50 border border-teal-200 rounded px-1.5 py-0.5">1 · Intent Resolver</span>
          <span>→</span>
          <span class="bg-teal-50 border border-teal-200 rounded px-1.5 py-0.5">2 · Planner</span>
          <span>→</span>
          <span class="bg-teal-50 border border-teal-200 rounded px-1.5 py-0.5">3 · Retrieval</span>
        </div>
      </a>

      <!-- arrow -->
      <div class="flex justify-center my-1 text-ink-subtle text-xl">↓</div>

      <!-- RT Benchmark -->
      <a href="#rt-benchmark" class="arch-node group block border border-rule rounded-lg p-4 mb-3 hover:border-accent hover:shadow-sm transition cursor-pointer bg-paper">
        <div class="flex items-center gap-2 mb-1">
          <span class="arch-icon text-accent">📊</span>
          <span class="font-medium text-sm">RT Benchmark</span>
          <code class="text-[10px] font-mono text-ink-subtle ml-auto">rt_benchmark.py</code>
        </div>
        <div class="text-xs text-ink-subtle">6 methods × 4 modes × 2 states → records.jsonl</div>
      </a>

      <!-- RT Results box -->
      <div class="mt-4 rounded-lg bg-accent-soft/30 border border-accent/20 p-3 text-xs text-ink-muted font-mono">
        results/runtime/ → skill_guided/ · skill_adjusted/ · dynamic/ · out_of_scope/
      </div>
    </div>
  </div>

  <!-- Methods strip below both columns -->
  <div class="border border-t-0 border-rule rounded-b-xl bg-paper px-6 py-4 flex flex-wrap gap-3 items-center">
    <span class="text-xs font-mono text-ink-subtle mr-2">retrieval methods:</span>
    {[
      { id: "A", label: "Embedding Cosine", file: "method_a.py", color: "bg-blue-50 border-blue-200 text-blue-800" },
      { id: "B", label: "Progressive Disclosure", file: "method_b.py", color: "bg-purple-50 border-purple-200 text-purple-800" },
      { id: "C", label: "Graph Walk", file: "method_c.py", color: "bg-green-50 border-green-200 text-green-800" },
      { id: "D", label: "Agentic Tool Use", file: "method_d.py", color: "bg-orange-50 border-orange-200 text-orange-800" },
      { id: "E", label: "Filesystem Agent", file: "method_e.py", color: "bg-red-50 border-red-200 text-red-800" },
      { id: "S", label: "Baseline Solver", file: "method_s.py", color: "bg-gray-50 border-gray-300 text-gray-700" },
    ].map(m => (
      <a href={`#method-${m.id.toLowerCase()}`}
         class={`inline-flex items-center gap-1.5 border rounded px-2.5 py-1 text-xs font-mono cursor-pointer hover:shadow-sm transition ${m.color}`}>
        <span class="font-bold">{m.id}</span>
        <span class="hidden sm:inline text-[10px]">{m.label}</span>
      </a>
    ))}
  </div>
</section>

<!-- ═══════════════════════════════════════════════════════════════════
     INTERACTIVE ORCHESTRATION FLOW
     ═══════════════════════════════════════════════════════════════════ -->
<section class="mb-16">
  <div class="flex items-center gap-3 mb-4">
    <h2 class="font-serif text-2xl font-semibold">Orchestration Flow</h2>
    <span class="text-xs font-mono text-ink-subtle bg-rule px-2 py-0.5 rounded">select an input type to see which components activate</span>
  </div>

  <!-- Input selector -->
  <div class="flex flex-wrap gap-2 mb-6">
    {[
      { id: "single",  label: "Single-Intent",  desc: "1 resource needed",          color: "bg-blue-50 border-blue-300 text-blue-800" },
      { id: "multi",   label: "Multi-Intent",   desc: "2+ independent resources",   color: "bg-purple-50 border-purple-300 text-purple-800" },
      { id: "skill",   label: "Skill-Guided",   desc: "known process end-to-end",   color: "bg-teal-50 border-teal-300 text-teal-800" },
      { id: "sa",      label: "Skill-Adjusted", desc: "known process + gap steps",  color: "bg-orange-50 border-orange-300 text-orange-800" },
      { id: "oos",     label: "Out-of-Scope",   desc: "no matching resource",       color: "bg-red-50 border-red-300 text-red-800" },
    ].map(t => (
      <button
        data-flow-input={t.id}
        class={`flow-input-btn border rounded-lg px-3 py-2 text-xs font-mono cursor-pointer hover:shadow transition ${t.color}`}
      >
        <div class="font-bold">{t.label}</div>
        <div class="opacity-70 mt-0.5">{t.desc}</div>
      </button>
    ))}
  </div>

  <!-- Flow chart -->
  <div class="border border-rule rounded-xl bg-white p-6 overflow-x-auto">
    <div class="min-w-[700px]">

      <!-- User input -->
      <div class="flex justify-center mb-2">
        <div id="flow-user" class="flow-node border-2 border-rule rounded-xl px-6 py-3 text-sm font-medium bg-paper text-center min-w-[180px] transition-all duration-300">
          <div class="text-xs font-mono text-ink-subtle mb-1">input</div>
          User Prompt
        </div>
      </div>
      <div class="flex justify-center mb-2"><div class="flow-arrow text-ink-subtle text-xl">↓</div></div>

      <!-- Intent Resolver — full width, always active -->
      <div class="flex justify-center mb-3">
        <div id="flow-resolver" class="flow-node border-2 border-rule rounded-xl px-6 py-3 text-sm font-medium bg-paper text-center min-w-[260px] transition-all duration-300">
          <div class="text-xs font-mono text-ink-subtle mb-1">stage 1 · 1 LLM call</div>
          Intent Resolver
          <div class="text-[10px] text-ink-subtle mt-1">skill_id matched  OR  null → dynamic</div>
        </div>
      </div>

      <!-- Branch labels -->
      <div class="grid grid-cols-2 gap-4 mb-1 px-8">
        <div class="text-center">
          <span id="flow-branch-skill" class="flow-branch text-xs font-mono text-ink-subtle opacity-30 transition-all duration-300">skill matched ↓</span>
        </div>
        <div class="text-center">
          <span id="flow-branch-dynamic" class="flow-branch text-xs font-mono text-ink-subtle opacity-30 transition-all duration-300">null → dynamic ↓</span>
        </div>
      </div>

      <!-- Two-column branch: Planner (left) | Decomposer (right) -->
      <div class="grid grid-cols-2 gap-4 mb-3 px-4">

        <!-- Left: Planner / Gap Resolver -->
        <div class="flex flex-col items-center gap-2">
          <div id="flow-planner" class="flow-node border-2 border-rule rounded-xl px-4 py-3 text-sm font-medium bg-paper text-center w-full transition-all duration-300">
            <div class="text-xs font-mono text-ink-subtle mb-1">stage 2 · 1 LLM call if skill</div>
            Planner / Gap Resolver
            <div class="text-[10px] text-ink-subtle mt-1">full · partial coverage</div>
          </div>
          <div class="text-ink-subtle text-xl">↓</div>
          <div class="flex gap-2 w-full justify-center">
            <div id="flow-step-skill" class="flow-node border-2 border-teal-300 rounded-lg px-3 py-2 text-xs font-mono text-teal-800 bg-teal-50 text-center opacity-20 transition-all duration-300 flex-1">
              skill steps<br/><span class="opacity-70">pinned</span>
            </div>
            <div id="flow-step-gap" class="flow-node border-2 border-orange-300 rounded-lg px-3 py-2 text-xs font-mono text-orange-800 bg-orange-50 text-center opacity-20 transition-all duration-300 flex-1">
              gap steps<br/><span class="opacity-70">→ retrieval</span>
            </div>
          </div>
        </div>

        <!-- Right: Intent Decomposer -->
        <div class="flex flex-col items-center gap-2">
          <div id="flow-decomposer" class="flow-node border-2 border-dashed border-purple-300 rounded-xl px-4 py-3 text-sm font-medium bg-purple-50 text-center w-full transition-all duration-300 opacity-20">
            <div class="text-xs font-mono text-purple-500 mb-1">stage 1b · 1 LLM call</div>
            Intent Decomposer
            <div class="text-[10px] text-purple-600 mt-1">single → 1 step · multi → N sub-queries</div>
          </div>
          <div class="text-ink-subtle text-xl">↓</div>
          <div class="flex gap-2 w-full justify-center">
            <div id="flow-step-adhoc" class="flow-node border-2 border-blue-300 rounded-lg px-3 py-2 text-xs font-mono text-blue-800 bg-blue-50 text-center opacity-20 transition-all duration-300 flex-1">
              adhoc step(s)<br/><span class="opacity-70">→ retrieval</span>
            </div>
            <div id="flow-step-refuse" class="flow-node border-2 border-red-300 rounded-lg px-3 py-2 text-xs font-mono text-red-800 bg-red-50 text-center opacity-20 transition-all duration-300 flex-1">
              refuse<br/><span class="opacity-70">D/E only</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Merge back to Retrieval -->
      <div class="flex justify-center mb-2 text-ink-subtle text-sm font-mono gap-16">
        <span>↘</span><span>↙</span>
      </div>

      <!-- Retrieval methods -->
      <div class="flex justify-center mb-1">
        <div id="flow-retrieval" class="flow-node border-2 border-rule rounded-xl px-6 py-3 text-sm font-medium bg-paper text-center min-w-[280px] transition-all duration-300">
          <div class="text-xs font-mono text-ink-subtle mb-2">stage 3 · per unbound step</div>
          <div class="flex gap-1 flex-wrap justify-center">
