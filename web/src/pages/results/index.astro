  if (dyRTr.length) renderDyRoutingTrace(0);

  // ── SA retrieval method×state viewer ──────────────────────────────────────
  const saAllTr = (window as any).__saAllTraces ?? {};
  let _currentSaMs = "A0";
  function renderSaMsCaseBtns(ms: string) {
    _currentSaMs = ms;
