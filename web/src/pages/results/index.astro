      : `<span class="bg-red-100 text-red-700 px-1.5 py-0.5 rounded font-mono text-[10px]">✗ not routed${dr.n_detected != null ? ` · decomp det=${dr.n_detected} gt=${dr.gt_n}` : ''}</span>`;
