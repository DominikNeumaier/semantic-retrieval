          if (!steps.length) return `<div class="border border-rule rounded p-3 bg-white opacity-40 text-[10px] font-mono text-ink-subtle">${m} — no trace</div>`;
          const hits = steps.filter((s) => (s.candidates?.[0]?.ordId ?? "") === (s.expected_ordIds?.[0] ?? "xx")).length;
          const p1 = steps.length > 0 ? (hits / steps.length).toFixed(2) : "—";
          const allCorrect = hits === steps.length;
          const noneCorrect = hits === 0;
          const stepRows = steps.map((s, i) => {
