                    <td class="py-2 pr-3 text-right font-mono text-sm text-ink-muted">
                      {(m === "F" ? r.top1_single : ph.top1_single) != null ? (m === "F" ? r.top1_single : ph.top1_single).toFixed(3) : "—"}
                    </td>
                    <td class="py-2 pr-3 text-right font-mono text-sm text-ink-muted">
                      {(m === "F" ? r.top1_multi : ph.top1_multi) != null ? (m === "F" ? r.top1_multi : ph.top1_multi).toFixed(3) : "—"}
                    </td>
                    <td class="py-2 pr-3 text-right font-mono text-sm text-purple-700">
                      {ph.recall_all_multi != null ? ph.recall_all_multi.toFixed(3) : "—"}
                    </td>
                    <td class="py-2 pr-3 text-right font-mono text-xs text-ink-subtle">{m === "F" ? "40" : (r.nRouted ?? "—")}</td>
                    <td class="py-2 pr-3 text-right font-mono text-xs text-orange-500">{m !== "F" && r.nForced > 0 ? r.nForced : "—"}</td>
                    <td class="py-2 text-right font-mono text-xs text-ink-subtle">
                      {r.total_tokens ? Math.round(r.total_tokens / r.cases).toLocaleString() : "—"}
                    </td>
                  </tr>
                );
              }))}
            </tbody>
          </table>
          <p class="text-[10px] font-mono text-ink-subtle mt-2">
            0 = clean · 1 = enriched · n(routed) = correctly routed by intent resolver · n(forced) orange = wrong-routed cases re-evaluated with force_mode=dynamic and merged into Top-1.
            <strong>Top-1 single/multi</strong> splits by query_class (original prompt, recall_any).
            <strong>Recall-all multi</strong> = all expected_ordIds in top-5. CI: 95% bootstrap.
            F uses forced records only (no router). See split below for single/multi breakdown.
          </p>

          {/* ── Forced + Split (collapsible) ── */}
          <div class="mt-6 border border-rule rounded-xl overflow-hidden">
            <button id="dy-forced-toggle" class="w-full flex items-center justify-between px-4 py-3 bg-rule/30 hover:bg-rule/50 transition text-left">
              <div class="flex items-center gap-3">
                <span class="font-mono text-xs font-semibold uppercase tracking-wider text-ink">Single-Intent / Multi-Intent split</span>
                <span class="text-[10px] font-mono text-ink-subtle bg-white px-2 py-0.5 rounded border border-rule">single: n=20 · multi: n=20 split-prompt · router bypassed</span>
              </div>
              <span id="dy-forced-arrow" class="text-ink-subtle text-sm">▸</span>
            </button>
            <div id="dy-forced-panel" class="hidden p-4">

              {/* Forced table — all 40 */}
              <div class="overflow-x-auto mb-6">
                <p class="text-[10px] font-mono text-ink-subtle mb-2">All 40 cases, router bypassed (force_mode=dynamic). F uses its own decomposer for multi-intent.</p>
                <table class="w-full text-xs border-collapse">
                  <thead>
                    <tr class="border-b-2 border-rule text-[10px] font-mono uppercase tracking-wider text-ink-subtle">
                      <th class="text-left py-2 pr-4">Cond</th>
                      <th class="text-left py-2 pr-4">Method</th>
                      <th class="text-right py-2 pr-3">n</th>
                      <th class="text-right py-2 pr-3 text-ink">Top-1</th>
                      <th class="text-right py-2 pr-3">Top-5</th>
                      <th class="text-right py-2">Tokens/case</th>
                    </tr>
                  </thead>
                  <tbody>
                    {dyForcedSummary.map((r: any) => {
                      const isF = r.method === 'F';
                      const rowBg = isF ? 'bg-gray-50' : (r.state === 'enriched' ? 'bg-blue-50/20' : '');
                      const t1 = r['Top-1'];
                      const t1Color = t1 >= 0.35 ? 'text-green-700 font-bold' : t1 >= 0.20 ? 'text-ink' : 'text-red-500';
                      return (
                        <tr class={`border-b border-rule/30 hover:bg-rule/20 ${rowBg}`}>
                          <td class="py-2 pr-4 font-mono text-[10px]">{r.condition}</td>
                          <td class="py-2 pr-4 text-ink-muted">{isF ? 'Hybrid (F)' : r.method}</td>
                          <td class="py-2 pr-3 text-right font-mono text-ink-subtle">{r.n}</td>
                          <td class={`py-2 pr-3 text-right font-mono text-base ${t1Color}`}>{t1.toFixed(3)}</td>
                          <td class="py-2 pr-3 text-right font-mono text-ink-muted">{r['Top-5'].toFixed(3)}</td>
                          <td class="py-2 text-right font-mono text-ink-subtle">{Math.round(r.total_tokens).toLocaleString()}</td>
                        </tr>
                      );
                    })}
                  </tbody>
                </table>
              </div>

              {/* Single / Multi split */}
              <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                {/* Single-Intent: forced *f, n=20 */}
                <div>
                  <div class="font-mono text-[10px] uppercase tracking-wider text-ink-subtle mb-2">Single-Intent — forced *f (n=20)</div>
                  <table class="w-full text-xs border-collapse">
                    <thead>
                      <tr class="border-b border-rule text-[10px] font-mono uppercase text-ink-subtle">
                        <th class="text-left py-1.5 pr-3">Cond</th>
                        <th class="text-right py-1.5 pr-3 text-ink">Top-1</th>
                        <th class="text-right py-1.5">Top-5</th>
                      </tr>
                    </thead>
                    <tbody>
                      {dyCombined.map((r: any) => {
                        if (r.single_top1 == null) return null;
                        const t1c = r.single_top1 >= 0.40 ? 'text-green-700 font-bold' : r.single_top1 >= 0.20 ? 'text-ink' : 'text-red-500';
                        return (
                          <tr class="border-b border-rule/20 hover:bg-rule/20">
                            <td class="py-1.5 pr-3 font-mono text-[10px]">{r.condition}</td>
                            <td class={`py-1.5 pr-3 text-right font-mono ${t1c}`}>{r.single_top1.toFixed(3)}</td>
                            <td class="py-1.5 text-right font-mono text-ink-muted">{r.single_top5?.toFixed(3) ?? '—'}</td>
                          </tr>
                        );
                      })}
                    </tbody>
                  </table>
                </div>

                {/* Multi-Intent: mh partial credit, n=20 cases */}
                <div>
                  <div class="font-mono text-[10px] uppercase tracking-wider text-ink-subtle mb-2">Multi-Intent — mh split prompt (n=20 cases · partial credit)</div>
                  <table class="w-full text-xs border-collapse">
                    <thead>
                      <tr class="border-b border-rule text-[10px] font-mono uppercase text-ink-subtle">
                        <th class="text-left py-1.5 pr-3">Cond</th>
                        <th class="text-right py-1.5 pr-3 text-ink">Top-1 partial</th>
                        <th class="text-right py-1.5">Strict</th>
                      </tr>
                    </thead>
                    <tbody>
                      {dyCombined.map((r: any) => {
                        if (r.mh_top1_partial == null) return null;
                        const t1c = r.mh_top1_partial >= 0.30 ? 'text-green-700 font-bold' : r.mh_top1_partial >= 0.15 ? 'text-ink' : 'text-red-500';
                        return (
                          <tr class="border-b border-rule/20 hover:bg-rule/20">
                            <td class="py-1.5 pr-3 font-mono text-[10px]">{r.condition}</td>
                            <td class={`py-1.5 pr-3 text-right font-mono ${t1c}`}>{r.mh_top1_partial.toFixed(3)}</td>
                            <td class="py-1.5 text-right font-mono text-ink-subtle">{r.mh_top1_strict?.toFixed(3) ?? '—'}</td>
                          </tr>
                        );
                      })}
                    </tbody>
                  </table>
                  <p class="text-[9px] font-mono text-ink-subtle mt-1">partial = mean(per-sub-query top1) · strict = both GTs top-1</p>
                </div>
              </div>

            </div>
          </div>

          {/* Termination breakdown for D/E across all RT modes */}
          {Object.keys(postHocTerm).length > 0 && (
            <div class="mt-6 border border-rule rounded-lg p-4 bg-paper">
              <div class="font-mono text-[10px] uppercase tracking-wider text-ink-subtle mb-3">Termination — agentic methods (D, E) across all RT modes</div>
              <table class="w-full text-xs">
                <thead>
                  <tr class="border-b border-rule text-[10px] font-mono uppercase tracking-wider text-ink-subtle">
                    <th class="text-left py-1 pr-3">Method · State</th>
                    <th class="text-right py-1 pr-3 text-green-700">picked</th>
                    <th class="text-right py-1 pr-3 text-blue-700">refused</th>
                    <th class="text-right py-1 pr-3 text-orange-600">budget exhausted</th>
                    <th class="text-right py-1 pr-1 text-ink-subtle">total</th>
                  </tr>
                </thead>
                <tbody>
                  {Object.entries(postHocTerm).sort(([a],[b]) => a.localeCompare(b)).map(([key, v]: [string, any]) => {
                    const total = v.picked + v.refused + v.budget_exhausted;
                    return (
                      <tr class="border-b border-rule/40">
                        <td class="py-1 pr-3 font-mono">{key}</td>
                        <td class="py-1 pr-3 text-right font-mono text-green-700">{v.picked}</td>
                        <td class="py-1 pr-3 text-right font-mono text-blue-700">{v.refused}</td>
                        <td class="py-1 pr-3 text-right font-mono text-orange-600">{v.budget_exhausted}</td>
                        <td class="py-1 pr-1 text-right font-mono text-ink-subtle">{total}</td>
                      </tr>
                    );
                  })}
                </tbody>
              </table>
              <p class="text-[10px] font-mono text-ink-subtle mt-2">
                Budget exhausted = agent ran out of tool calls (D: 8, E: 10) without an explicit pick or refuse — counted as ``no candidate'' in Top-1.
              </p>
            </div>
          )}
        </div>
      ) : <p class="text-sm text-ink-muted">No results yet.</p>}

      {/* Single-Intent / Multi-Intent split cards */}
      {(dySingleSummary.length > 0 || dyMultiSummary.length > 0) && (
        <div class="mt-6 mb-8 grid grid-cols-1 sm:grid-cols-2 gap-4">
          {([
            { key: "single", label: "Single-Intent", desc: "1 resource needed", data: dySingleSummary },
            { key: "multi",  label: "Multi-Intent",  desc: "2–3 resources needed", data: dyMultiSummary },
          ] as const).map(({ key, label, desc, data }) => {
            const bestTop1 = Math.max(...data.filter((r: any) => r.method !== "S").map((r: any) => r["Top-1"] ?? 0));
            return (
              <div class="border border-rule rounded-xl overflow-hidden">
                <button
                  class="dy-class-toggle w-full flex items-center justify-between px-5 py-3.5 bg-paper hover:bg-rule/30 transition text-left"
                  data-dy-class={key}
                >
                  <div class="flex items-center gap-3">
                    <span class="font-mono text-[10px] text-ink-subtle dy-class-arrow">▸</span>
                    <span class="font-serif text-base font-semibold">{label}</span>
                    <span class="text-[10px] font-mono text-ink-subtle">{desc}</span>
                  </div>
                  <span class="font-mono text-xs text-ink-subtle">n=20 · best P@1 {bestTop1.toFixed(3)}</span>
                </button>
                <div class="dy-class-panel hidden border-t border-rule">
                  <div class="overflow-x-auto">
                    <table class="w-full text-sm border-collapse">
                      <thead>
                        <tr class="border-b-2 border-rule text-xs font-mono uppercase tracking-wider text-ink-subtle">
                          <th class="text-left py-2 px-5">Cond</th>
                          <th class="text-left py-2 pr-4 hidden sm:table-cell">Method</th>
                          <th class="text-left py-2 pr-3">State</th>
                          <th class="text-right py-2 pr-3">n</th>
                          <th class="text-right py-2 pr-3 text-ink">Top-1</th>
                          <th class="text-right py-2 pr-3">Top-5</th>
                          <th class="text-right py-2 pr-3">n(routed)</th>
                          <th class="text-right py-2 pr-3">n(forced)</th>
                          <th class="text-right py-2 pr-5">Tokens/case</th>
                        </tr>
                      </thead>
                      <tbody>
                        {METHODS.map((m) => ["clean","enriched"].map((s) => {
                          const r = data.find((x: any) => x.method === m && x.state === s);
                          if (!r) return null;
                          const isBest = (r["Top-1"] ?? 0) === bestTop1 && m !== "S";
                          return (
                            <tr class={`border-b border-rule/40 hover:bg-rule/20 ${m === "S" ? "opacity-60" : ""} ${s === "enriched" ? "bg-blue-50/20" : ""}`}>
                              <td class="py-2 pl-5 pr-3 font-mono text-xs font-semibold">{r.condition}</td>
                              <td class="py-2 pr-4 text-xs text-ink-muted hidden sm:table-cell">{METHOD_DESC[m]}</td>
                              <td class="py-2 pr-3 font-mono text-[10px] text-ink-subtle">{s === "clean" ? "0" : "1"}</td>
                              <td class="py-2 pr-3 text-right font-mono text-xs text-ink-subtle">{r.cases}</td>
                              <td class={`py-2 pr-3 text-right font-mono font-bold ${isBest ? "text-green-700 text-base" : "text-sm"}`}>
                                {r["Top-1"] != null ? r["Top-1"].toFixed(3) : "—"}
                              </td>
                              <td class="py-2 pr-3 text-right font-mono text-sm">{r["Top-5"] != null ? r["Top-5"].toFixed(3) : "—"}</td>
                              <td class="py-2 pr-3 text-right font-mono text-xs text-ink-subtle">{r.nRouted ?? "—"}</td>
                              <td class="py-2 pr-3 text-right font-mono text-xs text-orange-500">{r.nForced > 0 ? r.nForced : "—"}</td>
                              <td class="py-2 pr-5 text-right font-mono text-xs text-ink-subtle">
                                {r.cases > 0 ? Math.round(r.total_tokens / r.cases).toLocaleString() : "—"}
                              </td>
                            </tr>
                          );
                        }))}
                      </tbody>
                    </table>
                  </div>
                </div>
              </div>
            );
          })}
        </div>
      )}

      {/* DY trace viewer — method × state */}
      <div class="mt-8">
        <h3 class="font-mono text-xs uppercase tracking-wider text-ink-subtle mb-3">Traces — select method and state</h3>
        <div class="flex flex-wrap gap-2 mb-4" id="dy-method-state-btns">
          {/* 12 buttons: A0, A1, B0, B1, C0, C1, D0, D1, E0, E1, S0, S1 */}
          {METHODS.map((m) => (
            <>
              <button data-dy-ms={m + "0"} class={"dy-ms-btn font-mono text-[10px] px-2.5 py-1 rounded border transition " + (m === "A" ? "border-accent bg-accent/10 text-ink" : "border-rule text-ink-subtle hover:bg-rule/30")}>
                {m} · Clean
              </button>
              <button data-dy-ms={m + "1"} class="dy-ms-btn font-mono text-[10px] px-2.5 py-1 rounded border border-rule text-ink-subtle hover:bg-rule/30 transition">
                {m} · Enrich
              </button>
            </>
          ))}
        </div>
        <div class="flex flex-wrap gap-1.5 mb-4" id="dy-trace-btns"></div>
        <div id="dy-trace-detail" class="rounded-lg border border-rule p-4 text-xs">
          <p class="text-ink-subtle font-mono text-[10px]">Select a method+state above, then a case</p>
        </div>
      </div>
    </div>

    {([
      {
        id: "oos", data: rtOOS,
        cols: [
          { key: "Refusal-Rate",    label: "Refusal-Rate", primary: true },
          { key: "False-Pick-Rate", label: "False-Pick",   primary: false },
          { key: "total_tokens",    label: "Tokens",       primary: false, tok: true },
        ],
        desc: "Refusal test — no resource in landscape matches. Refusal-Rate = primary. Routing-Acc omitted: the orchestrator never outputs mode=out_of_scope, that decision happens at retrieval level (refuse() call).",
      },
    ] as any[]).map(({ id, data, cols, desc }) => (
      <div data-subpanel={id} class={`sub-panel ${id === "oos" ? "hidden" : "hidden"}`}>
        <p class="text-xs text-ink-muted mb-4">{desc}</p>
        {data.length > 0 ? (
          <div class="overflow-x-auto">
            <table class="w-full text-sm border-collapse">
              <thead>
                <tr class="border-b-2 border-rule text-xs font-mono uppercase tracking-wider text-ink-subtle">
                  <th class="text-left py-2 pr-3">Cond</th>
                  <th class="text-left py-2 pr-4 hidden sm:table-cell">Method</th>
                  <th class="text-left py-2 pr-4 hidden md:table-cell">State</th>
                  <th class="text-right py-2 pr-3">n</th>
                  {cols.map((c: any) => (
                    <th class={`text-right py-2 pr-3 ${c.primary ? "text-ink" : ""}`}>{c.label}</th>
                  ))}
                </tr>
              </thead>
              <tbody>
                {METHODS.map((m) =>
                  ["clean","enriched"].map((s) => {
                    const r = data.find((x: any) => x.method === m && x.state === s);
                    if (!r) return null;
                    return (
                      <tr class={`border-b border-rule/40 hover:bg-rule/20 ${m === "S" ? "opacity-60" : ""} ${s === "enriched" ? "bg-blue-50/20" : ""}`}>
                        <td class="py-2 pr-3 font-mono text-xs font-semibold">{r.condition}</td>
                        <td class="py-2 pr-4 text-xs text-ink-muted hidden sm:table-cell">{METHOD_DESC[m]}</td>
                        <td class="py-2 pr-4 font-mono text-[10px] text-ink-subtle hidden md:table-cell">{s}</td>
                        <td class="py-2 pr-3 text-right font-mono text-xs text-ink-subtle">{r.cases}</td>
                        {cols.map((c: any) => {
                          const v = r[c.key];
                          const display = c.tok
                            ? (v != null ? Math.round(v / (r.cases || 1)).toLocaleString() : "—")
                            : (v != null ? v.toFixed(3) : "—");
                          return (
                            <td class={`py-2 pr-3 text-right font-mono text-sm ${c.primary && v != null && v >= 0.7 ? "text-green-700 font-bold" : c.primary && v != null && v < 0.3 ? "text-red-500" : ""}`}>
                              {display}
                            </td>
                          );
                        })}
                      </tr>
                    );
                  })
                )}
              </tbody>
            </table>
            <p class="text-[10px] font-mono text-ink-subtle mt-2">
              0 = clean-ORD · 1 = enriched-ORD · blue rows = enriched. Primary metric in bold if ≥ 0.7.
            </p>
          </div>
        ) : (
          <div class="border border-rule rounded-lg p-6 text-center bg-rule/20">
            <p class="text-sm text-ink-muted">No results yet — benchmark running.</p>
          </div>
        )}

        {/* OOS trace viewer — method × state like DY */}
        {id === "oos" && (
          <div class="mt-8">
            <h3 class="font-mono text-xs uppercase tracking-wider text-ink-subtle mb-3">Traces — select method and state</h3>
            <div class="flex flex-wrap gap-2 mb-4">
              {["A","B","C","D","E","S","F"].flatMap(m => ["0","1"].map(st => {
                const key = m + st;
                const count = (oosAllTraces[key] ?? []).length;
                const label = `${m} · ${st === "0" ? "Clean" : "Enrich"}`;
                return (
                  <button
                    data-oos-ms={key}
                    class={"oos-ms-btn font-mono text-[10px] px-3 py-1.5 rounded border transition hover:border-accent " + (key === "A0" ? "border-accent bg-accent-soft/40 text-accent-ink" : "border-rule bg-paper text-ink-muted")}
                  >
                    {label}
                    <span class="ml-1 text-[9px] opacity-60">{count}</span>
                  </button>
                );
              }))}
            </div>
            <div class="flex flex-wrap gap-1.5 mb-4" id="oos-ms-case-btns"></div>
            <div id="oos-ms-trace-detail" class="rounded-lg border border-rule p-4 text-xs">
              <p class="text-ink-subtle font-mono text-[10px]">Select a method above, then a case to inspect</p>
            </div>
          </div>
        )}
      </div>
    ))}
    </div>  {/* end retriever panel */}
  </section>
  </div>  {/* end runtime panel */}
</Base>

<script define:vars={{ _sg: sgCases, _sa: saMetrics.traces, _saRouting: saRoutingCases, _dyRouting: dyRoutingCases, _base: base, _dyC: dyTracesClean, _dyE: dyTracesEnriched, _oosC: oosTracesClean, _oosE: oosTracesEnriched, _dyAll: dyAllTraces, _saAll: saAllTraces, _oosAll: oosAllTraces, _dyDecompRouting: dyDecompRouting, _dyMhByCase: dyMhByCase }} is:inline>
  window.__sgTraces = _sg;
  window.__saTraces = _sa;
  window.__saAllTraces = _saAll;
  window.__saRouting = _saRouting;
  window.__dyRouting = _dyRouting;
  window.__dyDecompRouting = _dyDecompRouting;
  window.__dyMhByCase = _dyMhByCase;
  window.__base = _base;
  window.__dyTracesClean = _dyC;
  window.__dyTracesEnriched = _dyE;
  window.__oosTracesClean = _oosC;
  window.__oosTracesEnriched = _oosE;
  window.__oosAllTraces = _oosAll;
  window.__dyAllTraces = _dyAll;
</script>

<script>
  // ── Sub-tabs (Retriever: SA / DY / OOS) ──────────────────────────────────
  const subTabs = document.querySelectorAll<HTMLButtonElement>(".sub-tab");
  const subPanels = document.querySelectorAll<HTMLElement>("[data-subpanel]");
  function activateSub(id: string) {
    subTabs.forEach((t) => {
      const on = t.dataset.submode === id;
      t.classList.toggle("border-accent", on);
      t.classList.toggle("text-ink", on);
      t.classList.toggle("border-transparent", !on);
      t.classList.toggle("text-ink-subtle", !on);
    });
    subPanels.forEach((p) => { p.classList.toggle("hidden", p.dataset.subpanel !== id); });
    sessionStorage.setItem("rt-sub-tab", id);
  }
  subPanels.forEach((p) => { if (p.dataset.subpanel !== "sa") p.classList.add("hidden"); });
  const savedSub = sessionStorage.getItem("rt-sub-tab");
  if (savedSub) activateSub(savedSub);
  subTabs.forEach((t) => t.addEventListener("click", () => activateSub(t.dataset.submode!)));

  // ── Progress card → jump ─────────────────────────────────────────────────
  document.querySelectorAll<HTMLButtonElement>("[data-jump]").forEach((btn) => {
    btn.addEventListener("click", () => {
      const jump = btn.dataset.jump!;
      activate("runtime");
      if (jump === "sg") { activateRt("router"); }
      else { activateRt("retriever"); activateSub(jump); }
      document.querySelector(".rt-tab")?.scrollIntoView({ behavior: "smooth", block: "start" });
    });
  });

  // ── Tab switcher ──────────────────────────────────────────────────────────
  const tabs = document.querySelectorAll<HTMLButtonElement>(".res-tab");
  const panels = document.querySelectorAll<HTMLElement>(".res-panel");
  function activate(id: string) {
    tabs.forEach((t) => {
      const on = t.dataset.tab === id;
      t.classList.toggle("border-accent", on);
      t.classList.toggle("text-ink", on);
      t.classList.toggle("border-transparent", !on);
      t.classList.toggle("text-ink-subtle", !on);
    });
    panels.forEach((p) => { p.classList.toggle("hidden", p.dataset.panel !== id); });
    sessionStorage.setItem("results-tab", id);
  }
  // init: hide all except default
  panels.forEach((p) => { if (p.dataset.panel !== "design-time") p.classList.add("hidden"); });
  const savedTab = sessionStorage.getItem("results-tab");
  if (savedTab) activate(savedTab);
  tabs.forEach((t) => t.addEventListener("click", () => activate(t.dataset.tab!)));

  // ── RT mode tabs ─────────────────────────────────────────────────────────
  const rtTabs = document.querySelectorAll<HTMLButtonElement>(".rt-tab");
  const rtPanels = document.querySelectorAll<HTMLElement>(".rt-panel");
  function activateRt(id: string) {
    rtTabs.forEach((t) => {
      const on = t.dataset.rtmode === id;
      t.classList.toggle("border-accent", on);
      t.classList.toggle("text-ink", on);
      t.classList.toggle("border-transparent", !on);
      t.classList.toggle("text-ink-subtle", !on);
    });
    rtPanels.forEach((p) => { p.classList.toggle("hidden", p.dataset.rtpanel !== id); });
    sessionStorage.setItem("rt-mode-tab", id);
  }
  rtPanels.forEach((p) => { if (p.dataset.rtpanel !== "router") p.classList.add("hidden"); });
  const savedRt = sessionStorage.getItem("rt-mode-tab");
  if (savedRt) activateRt(savedRt);
  rtTabs.forEach((t) => t.addEventListener("click", () => activateRt(t.dataset.rtmode!)));

  // ── DY Single/Multi-Intent class toggles ────────────────────────────────
  document.querySelectorAll<HTMLElement>(".dy-class-toggle").forEach((btn) => {
    btn.addEventListener("click", () => {
      const panel = btn.nextElementSibling as HTMLElement;
      const arrow = btn.querySelector(".dy-class-arrow")!;
      const isOpen = !panel.classList.contains("hidden");
      panel.classList.toggle("hidden", isOpen);
      arrow.textContent = isOpen ? "▸" : "▾";
    });
  });

  // ── BPMN / CMMN notation toggles ─────────────────────────────────────────
  document.querySelectorAll<HTMLElement>(".notation-toggle").forEach((btn) => {
    btn.addEventListener("click", () => {
      const panel = btn.nextElementSibling as HTMLElement;
      const arrow = btn.querySelector(".toggle-arrow")!;
      const isOpen = !panel.classList.contains("hidden");
      panel.classList.toggle("hidden", isOpen);
      arrow.textContent = isOpen ? "▸" : "▾";
    });
  });

  // ── Process detail rows ───────────────────────────────────────────────────
  document.querySelectorAll<HTMLElement>(".proc-row").forEach((btn) => {
    btn.addEventListener("click", () => {
      const proc = btn.dataset.proc!;
      const detail = btn.nextElementSibling as HTMLElement;
      const arrow = btn.querySelector("span:first-child")!;
      const isOpen = !detail.classList.contains("hidden");

      if (isOpen) {
        detail.classList.add("hidden");
        arrow.textContent = "▸";
        return;
      }

      // Render trace cards — one card per method, showing all steps
      const detailGrid = document.getElementById(`detail-${proc}`)!;
      if (!detailGrid.children.length) {
        let traces: Record<string, any[]> = {};
        try { traces = JSON.parse(btn.dataset.traces ?? "{}"); } catch {}

        const METHODS = ["A","B","C","D","E","S","F"];
        const DESC: Record<string,string> = {A:"Embedding",B:"Prog. Disclosure",C:"Graph Walk",D:"Agentic",E:"Filesystem",S:"Baseline",F:"Hybrid (A+B+D)"};

        detailGrid.innerHTML = METHODS.map((m) => {
          const steps: any[] = traces[m] ?? [];
          if (!steps.length) return `<div class="border border-rule rounded p-3 bg-white opacity-40 text-[10px] font-mono text-ink-subtle">${m} — no trace</div>`;

          const hits = steps.filter((s) => (s.candidates?.[0]?.ordId ?? "") === (s.expected_ordIds?.[0] ?? "xx")).length;
          const p1 = steps.length > 0 ? (hits / steps.length).toFixed(2) : "—";
          const allCorrect = hits === steps.length;
          const noneCorrect = hits === 0;

          const stepRows = steps.map((s, i) => {
            const top1 = s.candidates?.[0]?.ordId ?? "";
            const expected = s.expected_ordIds?.[0] ?? "";
            const correct = top1 === expected;
            const label = (s.label ?? "").split(" — ")[0].substring(0, 35);
            const score = s.candidates?.[0]?.score;
            return `<div class="flex items-center gap-1.5 text-[9px] border-b border-rule/30 py-0.5 last:border-0">
              <span class="${correct ? "text-green-600" : "text-red-500"}">${correct ? "✓" : "✗"}</span>
              <span class="text-ink-subtle w-4 shrink-0">s${String(i+1).padStart(2,"0")}</span>
              <span class="truncate text-ink-muted flex-1">${label}</span>
              <span class="shrink-0 text-[8px] ${correct ? "text-green-600" : "text-red-500"}">${(top1.split(":")[2] ?? top1).substring(0,18)}</span>
              ${score != null ? `<span class="shrink-0 text-[8px] text-ink-subtle">${typeof score === "number" ? score.toFixed(2) : ""}</span>` : ""}
            </div>`;
          }).join("");

          return `<div class="border ${allCorrect ? "border-green-300 bg-green-50" : noneCorrect ? "border-red-200 bg-red-50/30" : "border-rule bg-white"} rounded-lg p-3">
            <div class="flex items-center justify-between mb-2">
              <span class="font-mono text-[10px] font-bold">${m}</span>
              <span class="text-[9px] font-mono text-ink-subtle">${DESC[m]}</span>
              <span class="font-mono text-[10px] font-bold ${allCorrect ? "text-green-700" : noneCorrect ? "text-red-600" : "text-yellow-600"}">P@1=${p1}</span>
            </div>
            <div class="space-y-0">${stepRows}</div>
          </div>`;
        }).join("");
      }

      detail.classList.remove("hidden");
      arrow.textContent = "▾";
    });
  });

  // ── SG trace viewer ───────────────────────────────────────────────────────
  const sgTr = (window as any).__sgTraces ?? [];
  const sgDet = document.getElementById("sg-trace-detail");
  function renderSgTrace(i: number) {
    const c = sgTr[i]; if (!c || !sgDet) return;
    sgDet.innerHTML = `<div class="flex flex-wrap items-center gap-2 mb-2"><span class="font-mono text-[10px] text-ink-subtle">${c.case_id}</span><span class="font-mono text-[10px] px-1.5 py-0.5 rounded ${c.routing_ok ? "bg-green-100 text-green-700" : "bg-red-100 text-red-700"}">${c.routing_ok ? "✓ routed" : "✗ wrong skill"}</span><span class="font-mono text-[10px] text-ink-subtle">expected: <strong>${c.skill_expected}</strong></span>${!c.routing_ok && c.skill_picked ? `<span class="font-mono text-[10px] text-red-600">picked: ${c.skill_picked}</span>` : ""}</div><p class="text-ink-muted text-[11px] mb-2 leading-relaxed">${c.user_prompt}</p>${c.reason ? `<p class="text-ink-subtle text-[10px] italic border-t border-rule pt-2">"${c.reason}"</p>` : ""}`;
    document.querySelectorAll<HTMLButtonElement>(".sg-trace-btn").forEach((b, j) => { b.classList.toggle("ring-1", j===i); b.classList.toggle("ring-accent", j===i); });
  }
  document.querySelectorAll<HTMLButtonElement>(".sg-trace-btn").forEach((btn, i) => btn.addEventListener("click", () => renderSgTrace(i)));
  if (sgTr.length) renderSgTrace(0);

  // ── SA trace viewer ───────────────────────────────────────────────────────
  // ── SA method×state trace viewer ─────────────────────────────────────────
  const saAllTr = (window as any).__saAllTraces ?? {};
  let _currentSaMs = "A0";

  function renderSaMsCaseBtns(ms: string) {
    _currentSaMs = ms;
    const traces = saAllTr[ms] ?? [];
    const caseBtns = document.getElementById("sa-ms-case-btns")!;

    const natural = traces.filter((t: any) => !t.was_forced);
    const forced  = traces.filter((t: any) => t.was_forced);

    function btnHtml(t: any, i: number) {
      const cls = t.gap_detection === 1
        ? "border-green-300 bg-green-50 text-green-700"
        : t.gap_detection > 0
          ? "border-yellow-300 bg-yellow-50 text-yellow-700"
          : "border-red-200 bg-red-50/50 text-red-700";
      const icon = t.gap_detection === 1 ? "✓" : t.gap_detection > 0 ? "~" : "✗";
      const sup = t.was_forced ? " ᶠ" : "";
      return `<button data-sa-ms-case="${i}" class="sa-ms-case-btn font-mono text-[10px] px-2 py-1 rounded border transition hover:border-accent ${cls}">${t.case_id} ${icon}${sup}</button>`;
    }

    let html = natural.map((t: any) => btnHtml(t, traces.indexOf(t))).join("");
    if (forced.length) {
      html += `<span class="font-mono text-[9px] text-orange-500 self-center px-1">— forced (planner said full) —</span>`;
      html += forced.map((t: any) => btnHtml(t, traces.indexOf(t))).join("");
    }
    caseBtns.innerHTML = html;

    document.querySelectorAll<HTMLButtonElement>(".sa-ms-case-btn").forEach((btn, i) =>
      btn.addEventListener("click", () => renderSaMsTrace(parseInt(btn.dataset.saMsCase!), _currentSaMs)));
    if (traces.length) renderSaMsTrace(0, ms);
  }

  function renderSaMsTrace(i: number, ms: string) {
    const traces = saAllTr[ms] ?? [];
    const t = traces[i];
    const det = document.getElementById("sa-ms-trace-detail")!;
    if (!t || !det) return;
    const base = (window as any).__base ?? "/";
    const gapRows = (t.gap_steps ?? []).map((s: any) => {
      const hit = (t.expected_gaps ?? []).includes(s.top1);
      const t5hit = !hit && (t.expected_gaps ?? []).some((g: string) => (s.top5 ?? []).includes(g));
      const ico = hit ? "✓" : t5hit ? "~" : "✗";
      const col = hit ? "text-green-600" : t5hit ? "text-yellow-600" : "text-red-500";
      const short = (id: string) => id.split(":")[2] ?? id;
      const ns1 = s.top1.split(":")[0]; const slug1 = s.top1.replace(/[:.]/g,"-");
      return `<div class="font-mono text-[10px] flex gap-1.5 mb-1">
        <span class="${col} w-3">${ico}</span>
        <span class="text-ink-subtle flex-1 truncate">${s.name}</span>
        <a href="${base}landscape/${ns1}/${slug1}/" class="text-accent hover:underline truncate max-w-[140px]">${short(s.top1)}</a>
      </div>`;
    }).join("") || '<div class="text-[10px] text-ink-subtle italic">no gap steps produced</div>';
    const expectedRows = (t.expected_gaps ?? []).map((g: string) => {
      const short = g.split(":")[2] ?? g;
      const ns = g.split(":")[0]; const slug = g.replace(/[:.]/g,"-");
      return `<div><a href="${base}landscape/${ns}/${slug}/" class="font-mono text-[10px] text-green-700 hover:underline">${short}</a></div>`;
    }).join("") || '<div class="text-[10px] text-ink-subtle italic">none</div>';
    const badge = t.gap_detection === 1
      ? `<span class="px-1.5 py-0.5 rounded bg-green-100 text-green-700 font-mono text-[10px]">✓ correct</span>`
      : t.gap_detection > 0
        ? `<span class="px-1.5 py-0.5 rounded bg-yellow-100 text-yellow-700 font-mono text-[10px]">~ partial</span>`
        : `<span class="px-1.5 py-0.5 rounded bg-red-100 text-red-700 font-mono text-[10px]">✗ wrong</span>`;
    const forcedBadge = t.was_forced
      ? `<span class="font-mono text-[10px] px-1.5 py-0.5 rounded bg-orange-50 border border-orange-200 text-orange-700">ᶠ gap-forced (planner said full)</span>`
      : '';
    det.innerHTML = `
      <div class="flex flex-wrap items-center gap-2 mb-2">
        <span class="font-mono text-[10px] text-ink-subtle">${t.case_id}</span>
        ${badge}
        ${forcedBadge}
        <a href="${base}processes/${t.skill}/" class="font-mono text-[10px] px-1.5 py-0.5 rounded bg-green-50 border border-green-200 text-green-700 hover:underline">${t.skill ?? "—"}</a>
      </div>
      <p class="text-ink-muted text-[11px] mb-3 leading-relaxed">${t.user_prompt ?? ""}…</p>
      <div class="grid grid-cols-2 gap-4">
        <div>
          <p class="font-mono text-[9px] text-ink-subtle uppercase mb-1">Expected gaps (${(t.expected_gaps??[]).length})</p>
          ${expectedRows}
        </div>
        <div>
          <p class="font-mono text-[9px] text-ink-subtle uppercase mb-1">Gap steps → top-1</p>
          ${gapRows}
        </div>
      </div>`;
    document.querySelectorAll<HTMLButtonElement>(".sa-ms-case-btn").forEach((b, j) =>
      b.classList.toggle("ring-1", j === i));
    document.querySelectorAll<HTMLButtonElement>(".sa-ms-case-btn").forEach((b, j) =>
      b.classList.toggle("ring-accent", j === i));
  }

  document.querySelectorAll<HTMLButtonElement>(".sa-ms-btn").forEach((btn) => {
    btn.addEventListener("click", () => {
      const ms = btn.dataset.saMs!;
      document.querySelectorAll<HTMLButtonElement>(".sa-ms-btn").forEach((b) => {
        const active = b.dataset.saMs === ms;
        b.className = "sa-ms-btn font-mono text-[10px] px-3 py-1.5 rounded border transition hover:border-accent "
          + (active ? "border-accent bg-accent-soft/40 text-accent-ink" : "border-rule bg-paper text-ink-muted");
      });
      renderSaMsCaseBtns(ms);
    });
  });
  renderSaMsCaseBtns("A0");

  // ── SA routing trace viewer ───────────────────────────────────────────────
  const saRTr = (window as any).__saRouting ?? [];
  const saRDet = document.getElementById("sa-routing-detail");
  function renderSaRoutingTrace(i: number) {
    const c = saRTr[i]; if (!c || !saRDet) return;
    const exact = c.predicted_gap_count === c.expected_gap_count && c.predicted_gap_count > 0;
    const partial = c.predicted_gap_count > 0 && !exact;
    const badge = exact ? `<span class="px-1.5 py-0.5 rounded bg-green-100 text-green-700">✓ exact (${c.predicted_gap_count}/${c.expected_gap_count})</span>`
      : partial ? `<span class="px-1.5 py-0.5 rounded bg-yellow-100 text-yellow-700">~ partial (${c.predicted_gap_count} found, ${c.expected_gap_count} expected)</span>`
      : `<span class="px-1.5 py-0.5 rounded bg-red-100 text-red-700">✗ no gap found (0/${c.expected_gap_count})</span>`;
    const expectedRows = (c.expected_gaps ?? []).map((g: string) =>
      `<div class="font-mono text-[10px] text-green-700">${g.split(':')[2] ?? g}</div>`).join('');
    const predictedRows = (c.predicted_gap_steps ?? []).map((s: string) =>
      `<div class="font-mono text-[10px] text-ink-muted">${s}</div>`).join('') || '<div class="text-[10px] text-red-500 italic">none</div>';
    saRDet.innerHTML = `
      <div class="flex flex-wrap items-center gap-2 mb-2">
        <span class="font-mono text-[10px] text-ink-subtle">${c.case_id}</span>
        ${badge}
        <a href="${(window).__base}processes/${c.skill_expected}/" class="font-mono text-[10px] px-1.5 py-0.5 rounded bg-green-50 border border-green-200 text-green-700">${c.skill_expected}</a>
      </div>
      <p class="text-ink-muted text-[11px] mb-3 leading-relaxed">${c.user_prompt?.slice(0,150)}…</p>
      <div class="grid grid-cols-2 gap-3">
        <div>
          <p class="font-mono text-[9px] text-ink-subtle uppercase mb-1">Expected gaps (${c.expected_gap_count})</p>
          ${expectedRows}
        </div>
        <div>
          <p class="font-mono text-[9px] text-ink-subtle uppercase mb-1">Planner predicted (${c.predicted_gap_count})</p>
          ${predictedRows}
        </div>
      </div>`;
    document.querySelectorAll<HTMLButtonElement>(".sa-routing-btn").forEach((b, j) => {
      const exact2 = saRTr[j]?.predicted_gap_count === saRTr[j]?.expected_gap_count && saRTr[j]?.predicted_gap_count > 0;
      const partial2 = saRTr[j]?.predicted_gap_count > 0 && !exact2;
      const cls2 = exact2 ? "border-green-300 bg-green-50 text-green-700" : partial2 ? "border-yellow-300 bg-yellow-50 text-yellow-700" : "border-red-200 bg-red-50/50 text-red-700";
      b.className = "sa-routing-btn font-mono text-[10px] px-2 py-1 rounded border transition " + cls2 + (j===i ? " ring-1 ring-accent" : "");
    });
  }
  document.querySelectorAll<HTMLButtonElement>(".sa-routing-btn").forEach((btn, i) => btn.addEventListener("click", () => renderSaRoutingTrace(i)));
  if (saRTr.length) renderSaRoutingTrace(0);

  // ── DY forced collapsible ─────────────────────────────────────────────────
  const dyForcedToggle = document.getElementById("dy-forced-toggle");
  const dyForcedPanel = document.getElementById("dy-forced-panel");
  const dyForcedArrow = document.getElementById("dy-forced-arrow");
  dyForcedToggle?.addEventListener("click", () => {
    const open = !dyForcedPanel!.classList.contains("hidden");
    dyForcedPanel!.classList.toggle("hidden", open);
    dyForcedArrow!.textContent = open ? "▸" : "▾";
  });

  // ── DY routing trace viewer ───────────────────────────────────────────────
  const dyRTr = (window as any).__dyRouting ?? [];
  const dyDecompR = (window as any).__dyDecompRouting ?? {};
  const dyRDet = document.getElementById("dy-routing-detail");
  function renderDyRoutingTrace(i: number) {
    const c = dyRTr[i]; if (!c || !dyRDet) return;
    const ok = c.routing_ok;
    const dr = dyDecompR[c.case_id] ?? {};
    const verdict = dr.verdict ?? 'red';
    const bothOk = ok && verdict === 'green';
    const oneOk  = ok || verdict !== 'red';
    const summaryBadge = bothOk
      ? '<span class="bg-green-100 text-green-700 px-1.5 py-0.5 rounded font-mono text-[10px]">✓ routed + decomp correct</span>'
      : oneOk
      ? `<span class="bg-yellow-100 text-yellow-700 px-1.5 py-0.5 rounded font-mono text-[10px]">~ ${ok ? 'routed ok' : 'not routed'} · decomp det=${dr.n_detected} gt=${dr.gt_n}</span>`
      : `<span class="bg-red-100 text-red-700 px-1.5 py-0.5 rounded font-mono text-[10px]">✗ not routed · decomp det=${dr.n_detected} gt=${dr.gt_n}</span>`;
    const subQueriesHtml = dr.sub_queries?.length
      ? `<div class="mt-2 border-t border-rule pt-2">
          <div class="text-[10px] font-mono text-ink-subtle mb-1">decomposer sub-queries (n_detected=${dr.n_detected}):</div>
          ${dr.sub_queries.map((sq: string, j: number) => `<div class="text-[10px] text-ink-muted pl-2 mb-0.5">${j+1}. ${sq}</div>`).join('')}
        </div>`
      : '';
    dyRDet.innerHTML = `
      <div class="flex flex-wrap items-center gap-2 mb-2">
        <span class="font-mono text-[10px] text-ink-subtle">${c.case_id}</span>
        <span class="font-mono text-[10px] px-1.5 py-0.5 rounded ${ok ? 'bg-green-100 text-green-700' : 'bg-red-100 text-red-700'}">${ok ? '✓ dynamic' : '✗ routed to skill'}</span>
        ${!ok && c.skill_picked ? `<a href="${(window as any).__base}processes/${c.skill_picked}/" class="font-mono text-[10px] px-1.5 py-0.5 rounded bg-red-50 border border-red-200 text-red-700">${c.skill_picked}</a>` : ''}
        ${summaryBadge}
      </div>
      <p class="text-ink-muted text-[11px] mb-2 leading-relaxed">${c.user_prompt}</p>
      ${c.reason ? `<p class="text-ink-subtle text-[10px] italic border-t border-rule pt-2">"${c.reason}"</p>` : ''}
      ${subQueriesHtml}
    `;
    document.querySelectorAll<HTMLButtonElement>(".dy-routing-btn").forEach((b, j) => { b.classList.toggle("ring-1", j===i); b.classList.toggle("ring-accent", j===i); });
  }
  document.querySelectorAll<HTMLButtonElement>(".dy-routing-btn").forEach((btn, i) => btn.addEventListener("click", () => renderDyRoutingTrace(i)));
  if (dyRTr.length) renderDyRoutingTrace(0);


  // ── DY method×state trace viewer ─────────────────────────────────────────
  const dyAllTr = (window as any).__dyAllTraces ?? {};
  let dyCurrentMs = 'A0';
  const dyBtnsEl = document.getElementById("dy-trace-btns");
  const dyDetEl = document.getElementById("dy-trace-detail");

  function renderDyMsButtons(ms: string) {
    const traces = dyAllTr[ms] ?? [];
    if (!dyBtnsEl) return;

    const natural = traces.filter((t: any) => !t.was_forced);
    const forced  = traces.filter((t: any) => t.was_forced);

    function btnHtml(t: any) {
      const i = traces.indexOf(t);
      const top1 = t.top1_correct; const top5 = t.top5_correct;
      const cls = top1 ? "border-green-300 bg-green-50 text-green-700"
        : top5 ? "border-yellow-300 bg-yellow-50 text-yellow-700"
        : "border-red-200 bg-red-50/50 text-red-700";
      const icon = top1 ? "✓" : top5 ? "~" : "✗";
      const sup = t.was_forced ? " ᶠ" : "";
      return `<button data-dy-trace-idx="${i}" class="dy-trace-btn font-mono text-[10px] px-2 py-1 rounded border transition ${cls} ${i===0?"ring-1 ring-accent":""}">${t.case_id} ${icon}${sup}</button>`;
    }

    let html = natural.map(btnHtml).join('');
    if (forced.length) {
      html += `<span class="font-mono text-[9px] text-orange-500 self-center px-1">— forced (wrong-routed) —</span>`;
      html += forced.map(btnHtml).join('');
    }
    dyBtnsEl.innerHTML = html;

    document.querySelectorAll<HTMLButtonElement>(".dy-trace-btn").forEach((btn) => {
      btn.addEventListener("click", () => renderDyMsTrace(parseInt(btn.dataset.dyTraceIdx!), ms));
    });
    if (traces.length) renderDyMsTrace(0, ms);
  }

  function renderDyMsTrace(i: number, ms: string) {
    const traces = dyAllTr[ms] ?? [];
    const t = traces[i]; if (!t || !dyDetEl) return;
    const base2 = (window as any).__base ?? '/';
    const top1ok = t.top1_correct; const top5ok = t.top5_correct;
    const cands: string[] = t.top5_candidates ?? [];
    const badge = top1ok ? '<span class="px-1.5 py-0.5 rounded bg-green-100 text-green-700">✓ top-1</span>'
      : top5ok ? '<span class="px-1.5 py-0.5 rounded bg-yellow-100 text-yellow-700">~ top-5</span>'
      : '<span class="px-1.5 py-0.5 rounded bg-red-100 text-red-700">✗ not found</span>';
    const forcedBadge = t.was_forced ? `<span class="font-mono text-[10px] px-1.5 py-0.5 rounded bg-orange-50 border border-orange-200 text-orange-700">forced (was→${t.skill_picked||'?'})</span>` : '';
    const classBadge = t.query_class === 'multi_intent' ? `<span class="font-mono text-[10px] px-1.5 py-0.5 rounded bg-purple-50 border border-purple-200 text-purple-700">multi-intent (${(t.expected_ordIds??[]).length} GT)</span>` : '';

    const mkLink = (id: string, highlight: boolean) => {
      const ns = id.split(':')[0]; const slug = id.replace(/[:.]/g, '-'); const lbl = id.split(':')[2] ?? id;
      return `<a href="${base2}landscape/${ns}/${slug}/" class="font-mono text-[10px] px-1.5 py-0.5 rounded bg-rule border border-rule/80 ${highlight ? 'text-green-700 font-semibold' : 'text-ink-muted'} hover:text-ink">${lbl}</a>`;
    };
    const mkCandRow = (c: string, n: number, gtSet: Set<string>) => {
      const isExp = gtSet.has(c); const ns = c.split(':')[0]; const slug = c.replace(/[:.]/g, '-'); const lbl = c.split(':')[2] ?? c;
      return `<div class="flex items-center gap-1.5 py-0.5"><span class="font-mono text-[9px] text-ink-subtle w-4">${n+1}.</span><a href="${base2}landscape/${ns}/${slug}/" class="font-mono text-[10px] ${isExp ? 'text-green-700 font-semibold' : 'text-ink-muted'} hover:underline">${lbl}</a>${isExp ? '<span class="text-green-600 text-[9px]">✓</span>' : ''}</div>`;
    };

    const header = `<div class="flex flex-wrap items-center gap-2 mb-2"><span class="font-mono text-[10px] text-ink-subtle">${t.case_id}</span>${badge}${classBadge}${forcedBadge}</div><p class="text-ink-muted text-[11px] mb-3 leading-relaxed">${t.user_prompt}…</p>`;

    let body = '';

    if (t.query_class === 'multi_intent') {
      const dr = ((window as any).__dyDecompRouting ?? {})[t.case_id] ?? {};
      const mhByCase = (window as any).__dyMhByCase ?? {};
      // Derive mh condition key: e.g. ms="A0" → "A0mh", ms="F0" → "F0mh"
      const mhCond = ms + "mh";
      const mhSubs: any[] = mhByCase[mhCond]?.[t.case_id] ?? [];
      const subQueries: string[] = mhSubs.length
        ? mhSubs.map((s: any) => s.sub_query)
        : (dr.sub_queries ?? []);
      const gtIds: string[] = t.expected_ordIds ?? [];
      const n_gt = gtIds.length;
      const fSubTraces = t.f_sub_traces ?? null;
      const fUnifiedPicks: string[] = t.f_unified_picks ?? [];

      const cols = gtIds.map((gt, idx) => {
        const sq = subQueries[idx] ?? '—';
        const expLink = mkLink(gt, false);
        const gtSet = new Set([gt]);

        let top5Html = '';
        const mhRec = mhSubs[idx];
        if (mhRec) {
          // Always use mh record for Top-5 (full 5 candidates, all methods incl. F)
          const mhCands: string[] = mhRec.top5_candidates ?? [];
          const refused = mhRec.refused ?? false;
          const top1ok = mhRec.top1_acc === 1;
          const top5ok = mhRec.candidate_recall === 1;
          const statusBadge = refused
            ? '<span class="text-[9px] text-orange-600 font-mono">refused</span>'
            : top1ok ? '<span class="text-[9px] text-green-600">✓ top-1</span>'
            : top5ok ? '<span class="text-[9px] text-yellow-600">~ top-5</span>'
            : '<span class="text-[9px] text-red-500">✗</span>';
          const rows = mhCands.map((c, n) => mkCandRow(c, n, gtSet)).join('');
          top5Html = `<div class="flex items-center gap-2 mb-1"><span class="font-mono text-[9px] uppercase text-ink-subtle">Top-5</span>${statusBadge}</div>
            <div>${rows || '<div class="italic text-[10px] text-ink-subtle">none</div>'}</div>`;
          // F: show unified re-rank pick as additional info
          if (fUnifiedPicks.length) {
            const uPick = fUnifiedPicks[idx];
            const uLabel = uPick ? uPick.split(':')[2] ?? uPick : '—';
            const uCorrect = uPick === gt;
            top5Html += `<div class="font-mono text-[9px] uppercase text-ink-subtle mt-2 mb-1">Unified pick (F)</div>
              <div class="flex items-center gap-1.5">
                <span class="font-mono text-[10px] ${uCorrect ? 'text-green-700 font-semibold' : 'text-orange-600'}">${uLabel}</span>
                ${uCorrect ? '<span class="text-green-600 text-[9px]">✓</span>' : ''}
              </div>`;
          }
        } else {
          // Fallback: shared pool (no mh record available)
          const top5h = cands.map((c, n) => mkCandRow(c, n, gtSet)).join('');
          top5Html = `<div class="font-mono text-[9px] uppercase text-ink-subtle mb-1">Top-5 (shared)</div>
            <div>${top5h || '<div class="italic text-[10px] text-ink-subtle">none</div>'}</div>`;
        }

        return `<div class="border border-rule rounded-lg p-3">
          <div class="font-mono text-[9px] uppercase text-ink-subtle mb-1">Sub-query ${idx+1}</div>
          <p class="text-[10px] text-ink-muted mb-2 leading-relaxed">${sq}</p>
          <div class="font-mono text-[9px] uppercase text-ink-subtle mb-1">Expected GT</div>
          <div class="mb-2">${expLink}</div>
          ${top5Html}
        </div>`;
      });
      body = `<div class="grid gap-3" style="grid-template-columns: repeat(${Math.min(n_gt, 3)}, 1fr)">${cols.join('')}</div>`;
    } else {
      // Single-intent: standard 2-col layout
      const exp = (t.expected_ordIds ?? []).map((g: string) => mkLink(g, false)).join(' ');
      const gtSet = new Set<string>(t.expected_ordIds ?? []);
      const top5rows = cands.map((c: string, n: number) => mkCandRow(c, n, gtSet)).join('');
      // D and E commit via pick_resource → only 1 candidate by design
      const isCommitMethod = ms.startsWith('D') || ms.startsWith('E');
      const top5Label = (isCommitMethod && cands.length <= 1)
        ? 'Pick (commits one)' : 'Top-5';
      body = `<div class="grid grid-cols-2 gap-4"><div><p class="font-mono text-[9px] uppercase text-ink-subtle mb-1">Expected</p><div class="flex flex-wrap gap-1">${exp || '<span class="italic text-[10px] text-ink-subtle">—</span>'}</div></div><div><p class="font-mono text-[9px] uppercase text-ink-subtle mb-1">${top5Label}</p>${top5rows || '<div class="italic text-[10px] text-ink-subtle">none</div>'}</div></div>`;
    }

    dyDetEl.innerHTML = header + body;
    document.querySelectorAll<HTMLButtonElement>(".dy-trace-btn").forEach((b, j) => { b.classList.toggle("ring-1", j===i); b.classList.toggle("ring-accent", j===i); });
  }

  document.querySelectorAll<HTMLButtonElement>(".dy-ms-btn").forEach(btn => {
    btn.addEventListener("click", () => {
      dyCurrentMs = btn.dataset.dyMs!;
      document.querySelectorAll<HTMLButtonElement>(".dy-ms-btn").forEach(b => {
        const on = b.dataset.dyMs === dyCurrentMs;
        b.className = `dy-ms-btn font-mono text-[10px] px-2.5 py-1 rounded border transition ${on ? "border-accent bg-accent/10 text-ink" : "border-rule text-ink-subtle hover:bg-rule/30"}`;
      });
      renderDyMsButtons(dyCurrentMs);
    });
  });
  if (dyBtnsEl) renderDyMsButtons('A0');

  // ── OOS retrieval trace viewer ────────────────────────────────────────────

  function ordLink(ordId: string) {
    if (!ordId) return '';
    const base = (window as any).__base ?? '/';
    const slug = ordId.replace(/[:]/g, '-').replace(/\//g, '-');
    const parts = ordId.split(':');
    const ns = parts[0] ?? '';
    const label = parts[2] ?? ordId;
    return `<a href="${base}landscape/${ns}/${slug}/" class="font-mono text-[10px] px-1.5 py-0.5 rounded bg-rule border border-rule/80 text-ink-muted hover:text-ink hover:border-accent">${label}</a>`;
  }

  // ── OOS method×state trace viewer ────────────────────────────────────────
  const oosAllTr = (window as any).__oosAllTraces ?? {};
  let _currentOosMs = "A0";
  const oosMsCaseBtns = document.getElementById("oos-ms-case-btns");
  const oosMsDet     = document.getElementById("oos-ms-trace-detail");

  function renderOosMsCaseBtns(ms: string) {
    _currentOosMs = ms;
    const traces = oosAllTr[ms] ?? [];
    if (!oosMsCaseBtns) return;
    oosMsCaseBtns.innerHTML = traces.map((t: any, i: number) => {
      const ok = t.correctly_refused;
      const cls = ok ? "border-green-300 bg-green-50 text-green-700" : "border-red-200 bg-red-50/50 text-red-700";
      const icon = ok ? "✓" : "✗";
      return `<button data-oos-ms-case="${i}" class="oos-ms-case-btn font-mono text-[10px] px-2 py-1 rounded border transition hover:border-accent ${cls} ${i===0?"ring-1 ring-accent":""}">${t.case_id} ${icon}</button>`;
    }).join('');
    document.querySelectorAll<HTMLButtonElement>(".oos-ms-case-btn").forEach((btn) =>
      btn.addEventListener("click", () => renderOosMsTrace(parseInt(btn.dataset.oosMsCase!), _currentOosMs)));
    if (traces.length) renderOosMsTrace(0, ms);
  }

  function renderOosMsTrace(i: number, ms: string) {
    const traces = oosAllTr[ms] ?? [];
    const t = traces[i];
    if (!t || !oosMsDet) return;
    const base = (window as any).__base ?? '/';
    const ok = t.correctly_refused;
    const badge = ok
      ? '<span class="px-1.5 py-0.5 rounded bg-green-100 text-green-700 font-mono text-[10px]">✓ correctly refused</span>'
      : '<span class="px-1.5 py-0.5 rounded bg-red-100 text-red-700 font-mono text-[10px]">✗ falsely picked</span>';
    let picked = '<div class="font-mono text-[10px] text-green-700 italic">— (refused)</div>';
    if (!ok && t.falsely_picked_ord_id) {
      const ns   = t.falsely_picked_ord_id.split(':')[0];
      const slug = t.falsely_picked_ord_id.replace(/[:.]/g, '-');
      const lbl  = t.falsely_picked_ord_id.split(':')[2] ?? t.falsely_picked_ord_id;
      picked = `<a href="${base}landscape/${ns}/${slug}/" class="font-mono text-[10px] text-red-600 hover:underline">${lbl}</a>`;
    }
    oosMsDet.innerHTML = `
      <div class="flex flex-wrap items-center gap-2 mb-2">
        <span class="font-mono text-[10px] text-ink-subtle">${t.case_id}</span>
        ${badge}
        ${t.topic ? `<span class="font-mono text-[10px] px-1.5 py-0.5 rounded bg-rule text-ink-subtle">${t.topic}</span>` : ''}
      </div>
      <p class="text-ink-muted text-[11px] mb-3 leading-relaxed">${t.user_prompt ?? ''}…</p>
      <div>
        <p class="font-mono text-[9px] uppercase text-ink-subtle mb-1">What the method returned</p>
        ${picked}
      </div>`;
    document.querySelectorAll<HTMLButtonElement>(".oos-ms-case-btn").forEach((b, j) => {
      b.classList.toggle("ring-1", j === i);
      b.classList.toggle("ring-accent", j === i);
    });
  }

  document.querySelectorAll<HTMLButtonElement>(".oos-ms-btn").forEach((btn) => {
    btn.addEventListener("click", () => {
      const ms = btn.dataset.oosMs!;
      document.querySelectorAll<HTMLButtonElement>(".oos-ms-btn").forEach((b) => {
        const on = b.dataset.oosMs === ms;
        b.className = "oos-ms-btn font-mono text-[10px] px-3 py-1.5 rounded border transition hover:border-accent "
          + (on ? "border-accent bg-accent-soft/40 text-accent-ink" : "border-rule bg-paper text-ink-muted");
      });
      renderOosMsCaseBtns(ms);
    });
  });
  const oosMsInitEl = document.querySelector<HTMLElement>("[data-oos-ms='A0']");
  if (oosMsInitEl) renderOosMsCaseBtns("A0");

  // ── DT case trace viewer ──────────────────────────────────────────────────
  const dtCasesAll = (window as any).__dtCases ?? {};
  let dtCurrentMethod = 'A';
  const dtBtnsEl = document.getElementById("dt-case-btns");
  const dtDetEl = document.getElementById("dt-case-detail");

  function renderDtCases(method: string) {
    const cases = dtCasesAll[method] ?? [];
    if (!dtBtnsEl) return;
    dtBtnsEl.innerHTML = cases.map((c: any, i: number) => {
      const cls = c.p_at_1 === 1 ? "border-green-300 bg-green-50 text-green-700"
        : c.r_at_5 === 1 ? "border-yellow-300 bg-yellow-50 text-yellow-700"
        : "border-red-200 bg-red-50/50 text-red-700";
      const icon = c.p_at_1 === 1 ? "✓" : c.r_at_5 === 1 ? "~" : "✗";
      return `<button data-dt-case-idx="${i}" class="dt-case-btn font-mono text-[10px] px-2 py-1 rounded border transition ${cls} ${i===0?"ring-1 ring-accent":""}">${c.case_id.replace(/_s0?/,'s')} ${icon}</button>`;
    }).join('');
    document.querySelectorAll<HTMLButtonElement>(".dt-case-btn").forEach((btn, i) => {
      btn.addEventListener("click", () => renderDtCase(i, method));
    });
    if (cases.length) renderDtCase(0, method);
  }

  function renderDtCase(i: number, method: string) {
    const cases = dtCasesAll[method] ?? [];
    const c = cases[i]; if (!c || !dtDetEl) return;
    const b = (window as any).__base ?? '/';
    const top1ok = c.p_at_1 === 1;
    const top5ok = c.r_at_5 === 1;
    const badge = top1ok ? '<span class="px-1.5 py-0.5 rounded bg-green-100 text-green-700">✓ P@1</span>'
      : top5ok ? '<span class="px-1.5 py-0.5 rounded bg-yellow-100 text-yellow-700">~ in R@5</span>'
      : '<span class="px-1.5 py-0.5 rounded bg-red-100 text-red-700">✗ not found</span>';
    const expLinks = (c.expected_ordIds ?? []).map((g: string) => {
      const ns = g.split(':')[0]; const slug = g.replace(/[:.]/g,'-'); const lbl = g.split(':')[2]??g;
      return `<a href="${b}landscape/${ns}/${slug}/" class="font-mono text-[10px] px-1.5 py-0.5 rounded bg-rule border border-rule/80 text-ink-muted hover:text-ink">${lbl}</a>`;
    }).join(' ');
    const top5rows = (c.top5 ?? []).map((oid: string, idx: number) => {
      const isExp = (c.expected_ordIds ?? []).includes(oid);
      const ns = oid.split(':')[0]; const slug = oid.replace(/[:.]/g,'-'); const lbl = oid.split(':')[2]??oid;
      return `<div class="flex items-center gap-1.5 py-0.5"><span class="font-mono text-[9px] text-ink-subtle w-4">${idx+1}.</span><a href="${b}landscape/${ns}/${slug}/" class="font-mono text-[10px] ${isExp?'text-green-700 font-semibold':'text-ink-muted'} hover:underline">${lbl}</a>${isExp?'<span class="text-green-600 text-[9px]">✓</span>':''}</div>`;
    }).join('');
    dtDetEl.innerHTML = `<div class="flex flex-wrap items-center gap-2 mb-2"><span class="font-mono text-[10px] text-ink-subtle">${c.case_id}</span>${badge}<a href="${b}processes/${c.process}/" class="font-mono text-[10px] px-1.5 py-0.5 rounded bg-rule text-ink-subtle hover:text-ink border border-rule">${c.process}</a></div><p class="text-ink-muted text-[11px] mb-3 leading-relaxed">${c.label}…</p><div class="grid grid-cols-2 gap-4"><div><p class="font-mono text-[9px] uppercase text-ink-subtle mb-1">Expected</p><div class="flex flex-wrap gap-1">${expLinks||'<span class="text-ink-subtle italic text-[10px]">—</span>'}</div></div><div><p class="font-mono text-[9px] uppercase text-ink-subtle mb-1">Top-5 candidates</p>${top5rows||'<div class="text-[10px] text-ink-subtle italic">none</div>'}</div></div>`;
    document.querySelectorAll<HTMLButtonElement>(".dt-case-btn").forEach((b, j) => { b.classList.toggle("ring-1", j===i); b.classList.toggle("ring-accent", j===i); });
  }

  document.querySelectorAll<HTMLButtonElement>(".dt-method-btn").forEach(btn => {
    btn.addEventListener("click", () => {
      dtCurrentMethod = btn.dataset.dtMethod!;
      document.querySelectorAll<HTMLButtonElement>(".dt-method-btn").forEach(b => {
        const on = b.dataset.dtMethod === dtCurrentMethod;
        b.className = `dt-method-btn font-mono text-[10px] px-3 py-1.5 rounded border transition ${on ? "border-accent bg-accent/10 text-ink" : "border-rule text-ink-subtle hover:bg-rule/30"}`;
      });
      renderDtCases(dtCurrentMethod);
    });
  });
  if (dtBtnsEl) renderDtCases('A');
</script>
