---
import Base from "../../layouts/Base.astro";
import fs from "node:fs";
import path from "node:path";

const ROOT  = path.resolve(process.cwd(), "..");  // cwd() = web/, ROOT = semantic-retrieval/
const base  = import.meta.env.BASE_URL;

function loadJson(p: string): any {
  return fs.existsSync(p) ? JSON.parse(fs.readFileSync(p, "utf8")) : [];
}

// Load SG routing results from eval_sg_routing (method-independent)
function loadSgCases(): any[] {
  const routingDir = path.join(ROOT, "results", "runtime", "skill_guided", "routing");
  if (!fs.existsSync(routingDir)) return [];
  return fs.readdirSync(routingDir)
    .filter(f => f.match(/^sg-\d+\.json$/))
    .sort()
    .map(f => JSON.parse(fs.readFileSync(path.join(routingDir, f), "utf8")));
}

const sgRoutingSummary: any = loadJson(path.join(ROOT, "results", "runtime", "skill_guided", "routing", "summary.json"));
const sgCases = loadSgCases();

const dtResults: any[]  = loadJson(path.join(ROOT, "results", "design-time", "summary.json"));
const dtByProc: any[]   = loadJson(path.join(ROOT, "results", "design-time", "by_process.json"));
const dtByModel: any[]  = loadJson(path.join(ROOT, "results", "design-time", "by_modeling_notation.json"));
const rtResults: any[]  = loadJson(path.join(ROOT, "results", "runtime", "summary.json"));
const postHoc: any      = loadJson(path.join(ROOT, "results", "runtime", "post_hoc_metrics.json"));
const postHocDy: Record<string, any> = postHoc.dy_metrics ?? {};
const postHocSa: Record<string, any> = postHoc.sa_metrics ?? {};
const postHocTerm: Record<string, any> = postHoc.termination ?? {};
const dyDecompRouting: Record<string, any> = loadJson(path.join(ROOT, "results", "runtime", "dynamic", "decomposer_routing.json")) ?? {};

// Load per-mode RT summaries
function loadRtMode(mode: string): any[] {
  return loadJson(path.join(ROOT, "results", "runtime", mode, "summary.json"));
}
const rtSA  = loadRtMode("skill_adjusted");
const rtDY  = loadRtMode("dynamic");
const rtOOS = loadRtMode("out_of_scope");

// Count records per mode for progress indicator (exclude forced 'f' records)
function countRecords(mode: string): number {
  const p = path.join(ROOT, "results", "runtime", mode, "records.jsonl");
  if (!fs.existsSync(p)) return 0;
  const lines = fs.readFileSync(p, "utf8").split("\n").filter(l => l.trim());
  // Count non-forced records (A-S) + F forced records (F0f/F1f)
  return lines.filter(l => {
    try {
      const r = JSON.parse(l);
      const cond = r.condition ?? '';
      if (cond.startsWith('F') && cond.endsWith('f')) return true; // F forced = primary
      return !cond.endsWith('f'); // A-S regular records
    } catch { return false; }
  }).length;
}

// SA split metrics: orchestration (method-agnostic) + retrieval (per condition)
function loadSaMetrics(records: any[]): { orch: any[]; retrieval: any[]; traces: any[] } {
  if (!records.length) return { orch: [], retrieval: [], traces: [] };

  // Merge gf (gap-forced) records into their base condition.
  // PREFER gf over regular: planner said "full coverage" → 0 gap steps → gf record
  // runs retrieval independently. Same principle as DY forced records.
  const regular: Map<string, any> = new Map();
  const forced: Map<string, any> = new Map();
  for (const r of records) {
    const k = `${r.case_id}|${r.method}|${r.state}`;
    if (r.condition?.endsWith('gf')) forced.set(k, { ...r, condition: r.condition.replace('gf','') });
    else regular.set(k, r);
  }
  // Build merged: gf wins where it exists, regular otherwise
  const merged: Map<string, any> = new Map(regular);
  for (const [k, r] of forced) merged.set(k, r);
  const cleanRecords = [...merged.values()];

  // Table 1: orchestration — just routing (gap_found === routing always)
  const byState: Record<string, any[]> = {};
  for (const r of cleanRecords) {
    (byState[r.state] = byState[r.state] || []).push(r);
  }
  const orch = Object.entries(byState).map(([state, recs]) => {
    const n = recs.length;
    const routing = recs.filter((r: any) => r.metrics.mode_routing_ok).length / n;
    return { state, n, routing: round3(routing) };
  }).sort((a, b) => a.state.localeCompare(b.state));
  // Table 2: retrieval — Top-1 and Top-5 per condition
  const byCond: Record<string, any[]> = {};
  for (const r of cleanRecords) {
    const baseCond = r.condition?.replace('gf','') || r.condition;
    (byCond[baseCond] = byCond[baseCond] || []).push(r);
  }
  const retrieval = Object.entries(byCond).map(([cond, recs]) => {
    const n = recs.length;
    // n(gap) = planner naturally produced gap steps; n(gap-forced) = retrieval run independently
    const gapFoundRecs  = recs.filter((r: any) => (r.plan?.steps ?? []).some((s: any) => s.source === 'gap'));
    const gapForcedRecs = recs.filter((r: any) => (r.plan?.steps ?? []).some((s: any) => s.source === 'gap_forced'));
    let top1sum = 0, top5sum = 0, top1foundsum = 0, top5foundsum = 0, toksum = 0;
    for (const r of recs) {
      const expected = new Set(r.expected_gaps ?? []);
      const gapSteps = (r.plan?.steps ?? []).filter((s: any) => s.source === 'gap' || s.source === 'gap_forced');
      const hasNaturalGap = (r.plan?.steps ?? []).some((s: any) => s.source === 'gap');
      if (expected.size > 0) {
        const t1 = [...expected].filter(eid =>
          gapSteps.some((s: any) => s.candidates?.[0]?.ordId === eid)
        ).length / expected.size;
        const t5 = [...expected].filter(eid =>
          gapSteps.some((s: any) => (s.candidates ?? []).slice(0,5).some((c: any) => c.ordId === eid))
        ).length / expected.size;
        top1sum += t1; top5sum += t5;
        if (hasNaturalGap) top1foundsum += t1;
        if (hasNaturalGap) top5foundsum += t5;
      }
      toksum += r.trace?.tokens ?? 0;
    }
    const nGap = gapFoundRecs.length;
    const nGapForced = gapForcedRecs.length;
    return {
      condition: cond, method: recs[0].method, state: recs[0].state, n, nGap, nGapForced,
      top1: round3(top1sum / n),
      top1found: nGap > 0 ? round3(top1foundsum / nGap) : null,
      top5found: nGap > 0 ? round3(top5foundsum / nGap) : null,
      top5: round3(top5sum / n),
      tok: Math.round(toksum / n),
    };
  }).sort((a, b) => a.condition.localeCompare(b.condition));
  // All A0 traces (use cleanRecords, exclude gf)
  const a0 = cleanRecords.filter((r: any) => r.method === 'A' && r.state === 'clean');
  const traces = a0.map((r: any) => ({
    case_id: r.case_id,
    prompt: r.user_prompt?.slice(0, 150),
    skill: r.skill_expected,
    expected_gaps: r.expected_gaps ?? [],
    gap_steps: (r.plan?.steps ?? []).filter((s: any) => s.source === 'gap' || s.source === 'gap_forced').map((s: any) => ({
      name: s.step_name?.slice(0, 60),
      top1: s.candidates?.[0]?.ordId ?? 'none',
    })),
    gap_detection: r.metrics.gap_detection,
    routing_ok: r.metrics.mode_routing_ok,
  }));
  return { orch, retrieval, traces };
}
function round3(v: number) { return Math.round(v * 1000) / 1000; }
const rtProgress = {
  skill_guided:   { done: 30, total: 30 },
  skill_adjusted: { done: countRecords("skill_adjusted"), total: 280 },
  dynamic:        { done: 560, total: 560 },
  out_of_scope:   { done: countRecords("out_of_scope"),   total: 280 },
};

// Load per-case traces for the process detail box (sample: first case per method per process)
const traceDir = path.join(ROOT, "results", "design-time", "traces");
function loadProcessTraces(procId: string): Record<string, any> {
  const result: Record<string, any> = {};
  // Load ALL steps for a process (s01–s08), not just s01
  for (const method of ["A","B","C","D","E","S","F"]) {
    const steps: any[] = [];
    for (let s = 1; s <= 8; s++) {
      const traceFile = path.join(traceDir, method, `${procId}_s${String(s).padStart(2,"0")}.json`);
      if (fs.existsSync(traceFile)) {
        steps.push(JSON.parse(fs.readFileSync(traceFile, "utf8")));
      }
    }
    if (steps.length > 0) result[method] = steps;
  }
  return result;
}

const METHODS = ["A", "B", "C", "D", "E", "S", "F"];
const METHOD_DESC: Record<string, string> = {
  A: "Embedding cosine",
  B: "Progressive Disclosure",
  C: "Graph Walk",
  D: "Agentic Tool Use",
  E: "Filesystem Agent",
  S: "Baseline-Solver (no-retrieval)",
  F: "Hybrid (A+D+B+C)",
};

// Load SA records for split metrics
function loadRecords(mode: string): any[] {
  const p = path.join(ROOT, "results", "runtime", mode, "records.jsonl");
  if (!fs.existsSync(p)) return [];
  const lines = fs.readFileSync(p, "utf8").split("\n").filter(l => l.trim());
  return lines.flatMap(l => { try { return [JSON.parse(l)]; } catch { return []; } });
}
const saRecords = loadRecords("skill_adjusted");
const saMetrics = loadSaMetrics(saRecords);

// Gap-Count-Acc: did the planner infer exactly the right number of gap steps?
// Computed method-independently from A0 (clean) records
const saCasesGt = loadJson(path.join(ROOT, "data", "test_cases", "runtime", "output", "skill_adjusted.json"));
const saGtCount: Record<string, number> = {};
for (const c of saCasesGt) saGtCount[c.case_id] = (c.expected_gap_ordIds ?? []).length;
const saA0 = saRecords.filter((r: any) => r.condition === 'A0' && !r.condition?.endsWith?.('gf'));
const saGapCountExact = saA0.filter((r: any) => {
  const found = (r.plan?.steps ?? []).filter((s: any) => s.source === 'gap' || s.source === 'gap_forced').length;
  return found === (saGtCount[r.case_id] ?? 0);
}).length;
const saGapCountAcc = saA0.length > 0 ? Math.round(saGapCountExact / saA0.length * 1000) / 1000 : null;
const saGapFound = saA0.filter((r: any) =>
  (r.plan?.steps ?? []).some((s: any) => s.source === 'gap' || s.source === 'gap_forced')
).length;
const saGapFoundRate = saA0.length > 0 ? Math.round(saGapFound / saA0.length * 1000) / 1000 : null;

// SA routing traces: one per case from condition A0
// SA uses hint_skill_id so routing_ok is always 1 — trace shows gaps expected
const saRoutingCases = saRecords
  .filter((r: any) => r.condition === 'A0' && !r.condition?.endsWith('gf'))
  .sort((a: any, b: any) => a.case_id.localeCompare(b.case_id))
  .map((r: any) => ({
    case_id: r.case_id,
    user_prompt: r.user_prompt,
    skill_expected: r.skill_expected,
    expected_gaps: r.expected_gaps ?? [],
    expected_gap_count: saGtCount[r.case_id] ?? 0,
    predicted_gap_steps: (r.plan?.steps ?? [])
      .filter((s: any) => s.source === 'gap' || s.source === 'gap_forced')
      .map((s: any) => s.step_name),
    predicted_gap_count: (r.plan?.steps ?? []).filter((s: any) => s.source === 'gap' || s.source === 'gap_forced').length,
    gap_detection: r.metrics.gap_detection,
    routing_ok: r.metrics.mode_routing_ok,
  }));

// DY routing traces: one per case from condition A0 (method-independent for routing)
const dyAllRecords = loadRecords("dynamic");
const dyByCaseId: Record<string, any> = {};
for (const r of dyAllRecords.filter((r: any) => r.condition === 'A0')) {
  dyByCaseId[r.case_id] = r;
}
const dyRoutingCases = Object.values(dyByCaseId)
  .sort((a: any, b: any) => a.case_id.localeCompare(b.case_id))
  .map((r: any) => {
    const orch = r.orchestration_trace ?? {};
    const intent = orch.intent_trace ?? orch.intent_resolver ?? {};
    return {
      case_id: r.case_id,
      user_prompt: r.user_prompt,
      routing_ok: r.metrics.mode_routing_ok,
      predicted_mode: r.metrics.predicted_mode,
      skill_picked: r.skill_picked,
      reason: intent.reason ?? '',
    };
  });

// Best P@1 for highlight
const bestDtP1 = dtResults.length > 0
  ? Math.max(...dtResults.filter((r: any) => r.method !== "S").map((r: any) => r["P@1"] ?? 0))
  : 0;

// Group by_process by process for table
const procGroups: Record<string, Record<string, any>> = {};
for (const r of dtByProc) {
  if (!procGroups[r.process]) procGroups[r.process] = {};
  procGroups[r.process][r.method] = r;
}
const procList = Object.entries(procGroups).sort(([a],[b]) => a.localeCompare(b));
const sgTracesJson = JSON.stringify(sgCases);

const saTracesJson = JSON.stringify(saMetrics.traces);

// DY traces for viewer (Method A, clean + enriched)
function loadModeTraces(mode: string, condition: string): any[] {
  const records = loadRecords(mode).filter((r: any) => r.condition === condition && !r.condition?.endsWith('f'));
  const cases = json.loads? [] : [];
  const byCase: Record<string, any> = {};
  for (const r of records) byCase[r.case_id] = r;
  return Object.values(byCase).sort((a: any, b: any) => a.case_id.localeCompare(b.case_id)).map((r: any) => {
    const step = r.plan?.steps?.[0] ?? {};
    const expected = step.expected?.expected_ordIds ?? [];
    const top1 = step.candidates?.[0]?.ordId ?? null;
    return {
      case_id: r.case_id,
      user_prompt: r.user_prompt?.slice(0, 150),
      top1_correct: r.metrics.top1_acc === 1,
      routing_ok: r.metrics.mode_routing_ok === 1,
      expected_ordIds: expected,
      top1_candidate: top1,
      skill_picked: r.skill_picked,
    };
  });
}

// OOS traces for viewer (Method A, clean + enriched)
function loadOosTraces(condition: string): any[] {
  const records = loadRecords("out_of_scope").filter((r: any) => r.condition === condition);
  const byCase: Record<string, any> = {};
  for (const r of records) byCase[r.case_id] = r;
  return Object.values(byCase).sort((a: any, b: any) => a.case_id.localeCompare(b.case_id)).map((r: any) => ({
    case_id: r.case_id,
    user_prompt: r.user_prompt?.slice(0, 150),
    topic: r.topic,
    correctly_refused: r.metrics.correctly_refused === 1,
    falsely_picked_ord_id: r.metrics.falsely_picked_ord_id,
  }));
}

// Precompute — DY Method A uses top1_acc; OOS uses correctly_refused
// DY: merge forced records for wrong-routed cases so n=40 with fair retrieval
function mergeDyRecords(condition: string): any[] {
  const allDy = loadRecords("dynamic");
  const real = allDy.filter((r: any) => r.condition === condition);
  const forced = allDy.filter((r: any) => r.condition === condition + 'f');
  const forcedMap: Record<string, any> = {};
  for (const r of forced) forcedMap[r.case_id] = r;
  const realMap: Record<string, any> = {};
  for (const r of real) realMap[r.case_id] = r;
  // For each case: use forced record if real was wrong-routed AND forced exists
  const merged: any[] = [];
  for (const [cid, r] of Object.entries(realMap)) {
    if ((r as any).metrics.mode_routing_ok === 0 && forcedMap[cid]) {
      merged.push({ ...(forcedMap[cid] as any), _was_forced: true, condition });
    } else {
      merged.push({ ...(r as any), _was_forced: false });
    }
  }
  return merged;
}

const dyA0merged = mergeDyRecords('A0');
const dyA1merged = mergeDyRecords('A1');
// Also keep raw (for routing viz)
const dyA0 = loadRecords("dynamic").filter((r: any) => r.condition === 'A0' && !r.condition?.endsWith('f'));
const dyA1 = loadRecords("dynamic").filter((r: any) => r.condition === 'A1' && !r.condition?.endsWith('f'));
const oosA0 = loadRecords("out_of_scope").filter((r: any) => r.condition === 'A0');
const oosA1 = loadRecords("out_of_scope").filter((r: any) => r.condition === 'A1');

function toTraceList(records: any[], type: 'dy'|'oos'): any[] {
  const byCase: Record<string, any> = {};
  for (const r of records) byCase[r.case_id] = r;
  return Object.values(byCase).sort((a: any, b: any) => a.case_id.localeCompare(b.case_id)).map((r: any) => {
    if (type === 'dy') {
      const step = r.plan?.steps?.[0] ?? {};
      const candidates = (step.candidates ?? []).slice(0, 5).map((c: any) => c.ordId);
      return {
        case_id: r.case_id, user_prompt: r.user_prompt?.slice(0,150),
        top1_correct: r.metrics.top1_acc === 1,
        top5_correct: r.metrics.candidate_recall === 1,
        routing_ok: r.metrics.mode_routing_ok === 1,
        was_forced: r._was_forced ?? false,
        expected_ordIds: step.expected?.expected_ordIds ?? [],
        top1_candidate: step.candidates?.[0]?.ordId ?? null,
        top5_candidates: candidates,
        skill_picked: r.skill_picked,
      };
    } else {
      return {
        case_id: r.case_id, user_prompt: r.user_prompt?.slice(0,150),
        topic: (r as any).topic,
        correctly_refused: r.metrics.correctly_refused === 1,
        falsely_picked_ord_id: r.metrics.falsely_picked_ord_id,
      };
    }
  });
}
const dyTracesClean = toTraceList(dyA0merged, 'dy');
const dyTracesEnriched = toTraceList(dyA1merged, 'dy');
const oosTracesClean = toTraceList(oosA0, 'oos');
const oosTracesEnriched = toTraceList(oosA1, 'oos');

// All OOS traces for all methods × states
const oosAllTraces: Record<string, any[]> = {};
for (const m of ["A","B","C","D","E","S","F"]) {
  for (const st of ["clean","enriched"]) {
    const key = m + (st === "clean" ? "0" : "1");
    const recs = loadRecords("out_of_scope").filter((r: any) => r.condition === key);
    const byCase: Record<string, any> = {};
    for (const r of recs) byCase[r.case_id] = r;
    oosAllTraces[key] = Object.values(byCase).sort((a: any, b: any) => a.case_id.localeCompare(b.case_id)).map((r: any) => ({
      case_id: r.case_id,
      user_prompt: r.user_prompt?.slice(0, 150),
      topic: r.topic,
      correctly_refused: r.metrics.correctly_refused === 1,
      falsely_picked_ord_id: r.metrics.falsely_picked_ord_id,
    }));
  }
}

// Compute merged DY summary (all methods × states) using forced records for wrong-routed cases
function buildDyMergedSummary(caseClasses: Record<string,string>, dyCombinedData: any[], mhRaw: any[]): any[] {
  const allDy = loadRecords("dynamic");
  const methods = ["A","B","C","D","E","S","F"];
  const states = ["clean","enriched"];
  const rows: any[] = [];
  for (const method of methods) {
    for (const state of states) {
      const cond = method + (state === "clean" ? "0" : "1");
      const real = allDy.filter((r: any) => r.condition === cond);
      const forced = allDy.filter((r: any) => r.condition === cond + 'f');
      const forcedMap: Record<string, any> = {};
      for (const r of forced) forcedMap[r.case_id] = r;

      // UNIFIED for all methods: single-intent from *f records,
      // multi-intent from *mh records (per-case partial credit).
      const singleForced = forced.filter((r: any) =>
        caseClasses[r.case_id] === "single_intent");
      const mhCond = cond + "mh";
      const mhRecords = mhRaw.filter((r: any) => r.condition === mhCond);
      const byCase: Record<string, any[]> = {};
      for (const r of mhRecords) {
        (byCase[r.case_id] = byCase[r.case_id] || []).push(r);
      }
      const multiSynth = Object.entries(byCase).map(([cid, subs]) => {
        const n = subs.length;
        const t1 = subs.reduce((s: number, x: any) => s + (x.top1_acc || 0), 0) / n;
        const t5 = subs.reduce((s: number, x: any) => s + (x.candidate_recall || 0), 0) / n;
        const tok = subs.reduce((s: number, x: any) => s + (x.tokens || 0), 0);
        return {
          case_id: cid, condition: cond,
          metrics: {
            top1_acc: t1 >= 1 ? 1 : 0,
            candidate_recall: t5 >= 0.5 ? 1 : 0,
            top1_partial: t1, top5_partial: t5,
            mode_routing_ok: 1,
          },
          trace: { tokens: tok },
          _from_mh: true,
        };
      });
      const merged = [...singleForced, ...multiSynth];

      if (!merged.length) continue;
      const n = merged.length;
      const nForced = merged.filter((r: any) => !r._from_mh).length;
      // Top-1 with partial credit on multi (per-sub-query mean)
      const top1 = merged.reduce((s: number, r: any) =>
        s + (r._from_mh ? (r.metrics.top1_partial || 0)
                        : (r.metrics?.top1_acc === 1 ? 1 : 0)), 0) / n;
      const top5 = merged.reduce((s: number, r: any) =>
        s + (r._from_mh ? (r.metrics.top5_partial || 0)
                        : (r.metrics?.candidate_recall === 1 ? 1 : 0)), 0) / n;
      // Routing accuracy: from regular (router-on) records — kept as is for context
      const nRouted = real.filter((r: any) => r.metrics?.mode_routing_ok === 1).length;
      const routing = real.length ? nRouted / real.length : 0;
      const tok = merged.reduce((s: number, r: any) => s + (r.trace?.tokens ?? 0), 0) / n;
      // Single / multi split
      const singleRows = merged.filter((r: any) => !r._from_mh);
      const top1Single = singleRows.length
        ? singleRows.filter((r: any) => r.metrics?.top1_acc === 1).length / singleRows.length
        : null;
      const multiRows = merged.filter((r: any) => r._from_mh);
      const top1Multi = multiRows.length
        ? multiRows.reduce((s: number, r: any) => s + (r.metrics.top1_partial || 0), 0) / multiRows.length
        : null;
      rows.push({ condition: cond, method, state, cases: n, nForced, nRouted,
        "Top-1": Math.round(top1*10000)/10000,
        "Top-5": Math.round(top5*10000)/10000,
        "Routing-Acc": Math.round(routing*10000)/10000,
        top1_single: top1Single != null ? Math.round(top1Single*10000)/10000 : null,
        top1_multi: top1Multi != null ? Math.round(top1Multi*10000)/10000 : null,
        total_tokens: Math.round(tok * n) });
    }
  }
  return rows;
}
const dyCombined: any[] = loadJson(path.join(ROOT, "results", "runtime", "dynamic", "summary_combined.json"))?.conditions ?? [];
const dyMhSummary: any[] = loadJson(path.join(ROOT, "results", "runtime", "dynamic", "summary_mh.json"))?.conditions ?? [];
// dyCasesRaw loaded below — build caseClasses after it
const dyCasesRaw: any[] = loadJson(path.join(ROOT, "data", "test_cases", "runtime", "output", "dynamic.json")) ?? [];
const _dyCC: Record<string,string> = {};
for (const c of dyCasesRaw) _dyCC[c.case_id] = c.query_class ?? "single_intent";
// Load mh records early so buildDyMergedSummary can use them for F's multi-intent
function loadMhRecordsEarly(): any[] {
  const p = path.join(ROOT, "results", "runtime", "dynamic", "records_mh.jsonl");
  if (!fs.existsSync(p)) return [];
  const out: any[] = [];
  for (const l of fs.readFileSync(p, "utf8").split("\n")) {
    if (!l.trim()) continue;
    try { out.push(JSON.parse(l)); } catch {}
  }
  return out;
}
const _mhRawEarly = loadMhRecordsEarly();
const dyMergedSummary = buildDyMergedSummary(_dyCC, dyCombined, _mhRawEarly);

// Build forced-only summary (A0f-F1f, all 40 cases)
function buildDyForcedSummary(): any[] {
  const allDy = loadRecords("dynamic");
  const methods = ["A","B","C","D","E","S","F"];
  const rows: any[] = [];
  for (const method of methods) {
    for (const suf of ["0f","1f"]) {
      const cond = method + suf;
      const recs = allDy.filter((r: any) => r.condition === cond);
      if (!recs.length) continue;
      const n = recs.length;
      const top1 = recs.filter((r: any) => r.metrics?.top1_acc === 1).length / n;
      const top5 = recs.filter((r: any) => r.metrics?.candidate_recall === 1).length / n;
      const tok = recs.reduce((s: number, r: any) => s + (r.trace?.tokens ?? 0), 0) / n;
      rows.push({ condition: cond, method, state: suf[0] === '0' ? 'clean' : 'enriched',
        n, "Top-1": Math.round(top1*10000)/10000,
        "Top-5": Math.round(top5*10000)/10000,
        total_tokens: Math.round(tok) });
    }
  }
  return rows;
}
const dyForcedSummary = buildDyForcedSummary();

// query_class per case_id (single_intent / multi_intent)
const dyQueryClass: Record<string, string> = {};
const dyExpectedAll: Record<string, string[]> = {};
const dyUserPromptAll: Record<string, string> = {};
for (const c of dyCasesRaw) {
  dyQueryClass[c.case_id] = c.query_class ?? "single_intent";
  dyExpectedAll[c.case_id] = c.expected_ordIds ?? [];
  dyUserPromptAll[c.case_id] = c.user_prompt ?? "";
}

function buildDyClassSummary(qclass: string): any[] {
  const allDy = loadRecords("dynamic");
  const caseIds = new Set(Object.entries(dyQueryClass).filter(([,v]) => v === qclass).map(([k]) => k));
  const methods = ["A","B","C","D","E","S","F"];
  const rows: any[] = [];
  for (const method of methods) {
    for (const state of ["clean","enriched"]) {
      const cond = method + (state === "clean" ? "0" : "1");
      const mhCond = cond + "mh";

      if (qclass === "multi_intent") {
        // Always use *mh records for multi-intent — per-case partial credit,
        // matching the summary table and detail view exactly.
        const mhRecs = (_mhRawEarly as any[]).filter(
          (r: any) => r.condition === mhCond && caseIds.has(r.case_id)
        );
        if (!mhRecs.length) continue;
        // Group by case, compute per-case mean top1 (partial credit)
        const byCase: Record<string, any[]> = {};
        for (const r of mhRecs) {
          if (!byCase[r.case_id]) byCase[r.case_id] = [];
          byCase[r.case_id].push(r);
        }
        const caseList = Object.values(byCase);
        const n = caseList.length;
        // top1 = mean of per-case mean(sub top1) — partial credit
        const top1 = caseList.reduce((s: number, subs: any[]) =>
          s + subs.reduce((ss: number, x: any) => ss + (x.top1_acc || 0), 0) / subs.length, 0) / n;
        // top5 = fraction of cases where ≥1 sub-query GT in top-5
        const top5 = caseList.filter((subs: any[]) => subs.some((x: any) => x.candidate_recall === 1)).length / n;
        const tok = mhRecs.reduce((s: number, r: any) => s + (r.tokens ?? 0), 0) / mhRecs.length;
        const nRouted = method === "F" ? n : allDy.filter((r: any) => r.condition === cond && caseIds.has(r.case_id) && r.metrics.mode_routing_ok === 1).length;
        const nForced = method === "F" ? n : allDy.filter((r: any) => r.condition === cond + 'f' && caseIds.has(r.case_id)).length;
        rows.push({ condition: cond, method, state, cases: n, nForced, nRouted,
          "Top-1": Math.round(top1*10000)/10000,
          "Top-5": Math.round(top5*10000)/10000,
          "Top-1-routed": null, "Top-5-routed": null, "Routing-Acc": 1,
          total_tokens: Math.round(tok * mhRecs.length) });
        continue;
      }

      // single_intent: use *f records (forced, router bypassed)
      const forced = allDy.filter((r: any) => r.condition === cond + 'f' && caseIds.has(r.case_id));
      let merged: any[];
      if (method === "F") {
        merged = forced;
      } else {
        // For A-S: use *f records for single-intent (same as summary table)
        merged = forced;
      }
      if (!merged.length) continue;
      const n = merged.length;
      const nForced = n;
      const top1 = merged.filter((r: any) => r.metrics.top1_acc === 1).length / n;
      const top5 = merged.filter((r: any) => r.metrics.candidate_recall === 1).length / n;
      const nRouted = method === "F" ? n : allDy.filter((r: any) => r.condition === cond && caseIds.has(r.case_id) && r.metrics.mode_routing_ok === 1).length;
      const tok = merged.reduce((s: number, r: any) => s + (r.trace?.tokens ?? 0), 0) / n;
      rows.push({ condition: cond, method, state, cases: n, nForced, nRouted,
        "Top-1": Math.round(top1*10000)/10000,
        "Top-5": Math.round(top5*10000)/10000,
        "Top-1-routed": null, "Top-5-routed": null,
        "Routing-Acc": method === "F" ? 1 : Math.round((nRouted/(allDy.filter((r: any) => r.condition === cond && caseIds.has(r.case_id)).length||1))*10000)/10000,
        total_tokens: Math.round(tok * n) });
    }
  }
  return rows;
}
const dySingleSummary = buildDyClassSummary("single_intent");
const dyMultiSummary  = buildDyClassSummary("multi_intent");

// All DY traces for all methods × states
// UNIFIED: single-intent (dy-01..20) always from *f, multi-intent (dy-21..40) always from *mh
const dyAllTraces: Record<string, any[]> = {};
const _allDyRecs = loadRecords("dynamic");
for (const m of ["A","B","C","D","E","S","F"]) {
  for (const st of ["clean","enriched"]) {
    const key = m + (st === "clean" ? "0" : "1");
    const mhCondKey = key + "mh";

    // Single-intent: *f records for dy-01..dy-20
    const singleRecs = _allDyRecs.filter((r: any) =>
      r.condition === key + "f" && (dyQueryClass[r.case_id] ?? "single_intent") === "single_intent"
    );

    // Multi-intent: one synthetic record per case from *mh sub-records
    const mhByCaseLocal: Record<string, any[]> = {};
    for (const r of (_mhRawEarly as any[])) {
      if (r.condition === mhCondKey) {
        if (!mhByCaseLocal[r.case_id]) mhByCaseLocal[r.case_id] = [];
        mhByCaseLocal[r.case_id].push(r);
      }
    }
    // Build one trace entry per multi-intent case from mh records
    const multiRecs: any[] = Object.entries(mhByCaseLocal)
      .filter(([cid]) => (dyQueryClass[cid] ?? "single_intent") === "multi_intent")
      .map(([cid, subs]) => ({
        case_id: cid,
        user_prompt: dyUserPromptAll[cid] ?? (subs[0] as any).sub_query,
        condition: key + "f",
        _from_mh: true,
        _mh_subs: (subs as any[]).sort((a: any, b: any) => a.sub_idx - b.sub_idx),
        metrics: { mode_routing_ok: 1 },
        plan: { steps: [{ candidates: [] }] },
        skill_picked: null,
      }));

    const allRecs = [...singleRecs, ...multiRecs]
      .sort((a: any, b: any) => a.case_id.localeCompare(b.case_id));

    dyAllTraces[key] = allRecs.map((r: any) => {
      const qc = dyQueryClass[r.case_id] ?? "single_intent";

      // Badge: top1/top5 from mh for multi-intent, from record for single
      let recomputedTop1: boolean;
      let recomputedTop5: boolean;
      let top5Candidates: string[];
      let top1Candidate: string | null;

      if (qc === "multi_intent") {
        const mhSubs: any[] = r._mh_subs ?? [];
        const top1Hits = mhSubs.filter((s: any) => s.top1_acc === 1).length;
        const top5Hits = mhSubs.filter((s: any) => s.candidate_recall === 1).length;
        recomputedTop1 = top1Hits === mhSubs.length && mhSubs.length > 0;
        recomputedTop5 = top5Hits > 0;
        top5Candidates = [];
        top1Candidate = null;
      } else {
        const step = r.plan?.steps?.[0] ?? {};
        const candidates = (step.candidates ?? []).slice(0, 5).map((c: any) => c.ordId);
        const currentGt = dyExpectedAll[r.case_id] ?? step.expected?.expected_ordIds ?? [];
        const gtSet = new Set(currentGt);
        recomputedTop1 = candidates.length > 0 && gtSet.has(candidates[0]);
        recomputedTop5 = candidates.some((c: string) => gtSet.has(c));
        top5Candidates = candidates;
        top1Candidate = step.candidates?.[0]?.ordId ?? null;
      }

      const mt = (r.plan?.steps?.[0]?.method_trace) ?? {};
      return {
        case_id: r.case_id,
        user_prompt: r.user_prompt?.slice(0, 150),
        top1_correct: recomputedTop1,
        top5_correct: recomputedTop5,
        routing_ok: true,
        was_forced: false,
        expected_ordIds: dyExpectedAll[r.case_id] ?? [],
        query_class: qc,
        top1_candidate: top1Candidate,
        top5_candidates: top5Candidates,
        skill_picked: r.skill_picked,
        f_sub_traces: mt.sub_traces ?? null,
        f_unified_picks: mt.unified_rerank?.picks ?? null,
      };
    });
  }
}

// mh records lookup: {A0mh: {dy-21: [{sub_idx,top5_candidates,gt_id,top1_acc},...], ...}}
function loadMhRecords(): any[] {
  const p = path.join(ROOT, "results", "runtime", "dynamic", "records_mh.jsonl");
  if (!fs.existsSync(p)) return [];
  const out: any[] = [];
  for (const l of fs.readFileSync(p, "utf8").split("\n")) {
    if (!l.trim()) continue;
    try { out.push(JSON.parse(l)); } catch {}
  }
  return out;
}
const _mhRaw = loadMhRecords();
// Build lookup: condition → case_id → sorted sub-records
const dyMhByCase: Record<string, Record<string, any[]>> = {};
for (const r of _mhRaw) {
  const cond = r.condition as string;
  const cid = r.case_id as string;
  if (!dyMhByCase[cond]) dyMhByCase[cond] = {};
  if (!dyMhByCase[cond][cid]) dyMhByCase[cond][cid] = [];
  dyMhByCase[cond][cid].push(r);
}
// Sort each case's subs by sub_idx
for (const cond of Object.keys(dyMhByCase)) {
  for (const cid of Object.keys(dyMhByCase[cond])) {
    dyMhByCase[cond][cid].sort((a: any, b: any) => a.sub_idx - b.sub_idx);
  }
}


// For cases where planner produced 0 gap steps (sa-07, sa-15), prefer the gf record
// (gap-forced retrieval, independent of router) — same principle as DY forced records.
const saAllTraces: Record<string, any[]> = {};
for (const m of ["A","B","C","D","E","S","F"]) {
  for (const st of ["clean","enriched"]) {
    const key = m + (st === "clean" ? "0" : "1");
    const real   = saRecords.filter((r: any) => r.condition === key);
    const forced = saRecords.filter((r: any) => r.condition === key + "gf");
    const forcedMap: Record<string, any> = {};
    for (const r of forced) forcedMap[r.case_id] = r;
    // Prefer gf when it exists (planner had 0 gap steps → use forced retrieval)
    const recs = real.map((r: any) =>
      forcedMap[r.case_id] ? { ...forcedMap[r.case_id], _was_forced: true, condition: key } : r
    );
    saAllTraces[key] = recs.sort((a: any, b: any) => a.case_id.localeCompare(b.case_id)).map((r: any) => {
      const gapSteps = (r.plan?.steps ?? []).filter((s: any) => s.source === 'gap' || s.source === 'gap_forced');
      const expectedGaps = r.expected_gaps ?? [];
      const top1Correct = expectedGaps.length > 0
        ? gapSteps.some((s: any) => expectedGaps.includes(s.candidates?.[0]?.ordId))
        : null;
      const top5Correct = expectedGaps.length > 0
        ? gapSteps.some((s: any) => (s.candidates ?? []).slice(0,5).some((c: any) => expectedGaps.includes(c.ordId)))
        : null;
      return {
        case_id: r.case_id,
        user_prompt: r.user_prompt?.slice(0, 150),
        skill: r.skill_expected,
        expected_gaps: expectedGaps,
        gap_detection: r.metrics.gap_detection,
        routing_ok: r.metrics.mode_routing_ok,
        was_forced: r._was_forced ?? false,
        top1_correct: top1Correct,
        top5_correct: top5Correct,
        gap_steps: gapSteps.map((s: any) => ({
          name: s.step_name?.slice(0, 60),
          top1: s.candidates?.[0]?.ordId ?? 'none',
          top5: (s.candidates ?? []).slice(0,5).map((c: any) => c.ordId),
        })),
      };
    });
  }
}
