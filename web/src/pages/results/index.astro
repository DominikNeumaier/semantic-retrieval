---
import Base from "../../layouts/Base.astro";
import {
  METHODS, METHOD_DESC,
  buildOrchestrationSummary, buildRetrievalDesignTime, loadDesignTimeTraces,
  buildRetrievalSkillGuided, buildRetrievalSA, buildRetrievalDynamic, buildRetrievalOOS,
} from "../../lib/resultsData";

const base = import.meta.env.BASE_URL;

// ─── aggregate everything from the trace tree ────────────────────────────────
const orch = buildOrchestrationSummary();
const dt   = buildRetrievalDesignTime();
const sgRet = buildRetrievalSkillGuided();
const sa   = buildRetrievalSA();
const dy   = buildRetrievalDynamic();
const oos  = buildRetrievalOOS();

const dtResults: any[] = dt.summary;
const dtByModel: any[] = dt.byNotation;
const bestDtP1 = dtResults.length
  ? Math.max(...dtResults.filter((r: any) => r.method !== "S").map((r: any) => r["P@1"] ?? 0))
  : 0;

// group design-time per-process rows for the breakdown table
const procGroups: Record<string, Record<string, any>> = {};
for (const r of dt.byProcess) {
  (procGroups[r.process] ||= {})[r.method] = r;
}
const procList = Object.entries(procGroups).sort(([a], [b]) => a.localeCompare(b));

// design-time step traces grouped by process (for the clickable detail cards)
const dtTracesByMethod: Record<string, any[]> = {};
for (const m of METHODS) dtTracesByMethod[m] = loadDesignTimeTraces(m);
function loadProcessTraces(proc: string): Record<string, any[]> {
  const result: Record<string, any[]> = {};
  for (const m of METHODS) {
    const steps = dtTracesByMethod[m]
      .filter((t: any) => t.process === proc)
      .sort((a: any, b: any) => a.case_id.localeCompare(b.case_id));
    if (steps.length) result[m] = steps;
  }
  return result;
}

// status counts
const status = {
  sg: orch.sg.cases,
  sa: orch.sa.cases,
  dy: orch.dy.cases,
  dtPerMethod: dtTracesByMethod["A"]?.length ?? 0,
  retSA: sa.rows.reduce((a, r) => a + r.n, 0),
  retDY: dy.rows.reduce((a, r) => a + r.n, 0),
  retOOS: oos.rows.reduce((a, r) => a + r.n, 0),
};

// termination rows (agentic methods only)
const termRows = dy.rows
  .filter((r: any) => dy.termination[r.cond])
  .map((r: any) => ({ cond: r.cond, ...dy.termination[r.cond] }));
---

<Base title="Results" subtitle="Evaluation metrics across all methods and ORD states">
  <div class="font-mono text-xs text-ink-subtle mb-6 flex items-center gap-2">
    <a href={`${base}`} class="hover:text-ink underline-offset-2 hover:underline">ORD-Bench</a>
    <span>·</span><span class="text-ink">Results</span>
    <span class="ml-auto">
      <span class="font-mono text-[10px] text-ink-subtle">→ construction logs: see ord-bench</span>
    </span>
  </div>

  <!-- Status strip -->
  <div class="grid grid-cols-2 md:grid-cols-4 gap-3 mb-8 font-mono text-[10px]">
    {([
      { label: "Orchestration", detail: `SG ${status.sg} · SA ${status.sa} · DY ${status.dy}` },
      { label: "Design-Time",   detail: `${status.dtPerMethod} cases × 7 methods` },
      { label: "Retrieval SA/DY", detail: `${status.retSA} SA · ${status.retDY} DY` },
      { label: "Out-of-Scope",  detail: `${status.retOOS} refusal cases` },
    ]).map(({ label, detail }) => (
      <div class="rounded-lg border border-rule bg-rule/20 p-3">
        <div class="uppercase tracking-wider text-ink-subtle mb-1">{label}</div>
        <div class="text-ink-muted">{detail}</div>
      </div>
    ))}
  </div>

  <!-- Top tabs: Orchestration / Retrieval -->
  <div class="flex gap-0 mb-8 border-b border-rule">
    {[
      { id: "orchestration", label: "Orchestration", badge: "routing · gaps · decomposition" },
      { id: "retrieval",     label: "Retrieval",     badge: "per method × state" },
    ].map((t, i) => (
      <button data-tab={t.id} class={`res-tab px-5 py-2.5 text-sm font-medium border-b-2 -mb-px transition-colors ${i === 0 ? "border-accent text-ink" : "border-transparent text-ink-subtle"}`}>
        {t.label}
        <span class="ml-1.5 font-mono text-xs text-ink-subtle hidden sm:inline">{t.badge}</span>
      </button>
    ))}
  </div>

  {/* ═══════════ ORCHESTRATION ═══════════ */}
  <div data-panel="orchestration" class="res-panel">
  <section class="mb-14">
    <h2 class="font-serif text-xl font-semibold mb-1">Orchestration</h2>
    <p class="text-xs text-ink-muted mb-6 max-w-2xl">
      Natural end-to-end runs. The intent resolver decides the mode (skill match, skill+gap, ad-hoc), the planner finds coverage gaps, and the decomposer splits multi-intent prompts. Method-independent, evaluated once per case from Method A (clean-ORD).
    </p>

    <div class="overflow-x-auto mb-8">
      <table class="w-full text-sm border-collapse">
        <thead>
          <tr class="border-b-2 border-rule text-xs font-mono uppercase tracking-wider text-ink-subtle">
            <th class="text-left py-2 pr-4">Scenario</th>
            <th class="text-left py-2 pr-4">Question</th>
            <th class="text-right py-2 pr-3">Cases</th>
            <th class="text-right py-2 pr-3 text-ink">Routing-Acc</th>
            <th class="text-right py-2 pr-3 text-ink">Skill-Acc</th>
            <th class="text-right py-2 pr-3">Gap-Found</th>
            <th class="text-right py-2 pr-3">Gap-Count-Acc</th>
            <th class="text-right py-2 pr-3">Decomp-Acc</th>
            <th class="text-right py-2">Tokens/call</th>
          </tr>
        </thead>
        <tbody>
          <tr class="border-b border-rule/40 hover:bg-rule/20">
            <td class="py-2.5 pr-4 font-mono text-xs font-semibold">Skill-Guided</td>
            <td class="py-2.5 pr-4 text-xs text-ink-muted">Recognised as skill-guided?</td>
            <td class="py-2.5 pr-3 text-right font-mono text-xs text-ink-subtle">{orch.sg.cases}</td>
            <td class={`py-2.5 pr-3 text-right font-mono font-bold text-base ${orch.sg.routingAcc >= 0.7 ? "text-green-700" : "text-red-500"}`}>
              {orch.sg.routingAcc.toFixed(3)}
            </td>
            <td class={`py-2.5 pr-3 text-right font-mono text-sm ${orch.sg.skillAcc >= 0.7 ? "text-green-700 font-semibold" : "text-red-500"}`}>
              {orch.sg.skillAcc.toFixed(3)}
            </td>
            <td class="py-2.5 pr-3 text-right font-mono text-xs text-ink-subtle">—</td>
            <td class="py-2.5 pr-3 text-right font-mono text-xs text-ink-subtle">—</td>
            <td class="py-2.5 pr-3 text-right font-mono text-xs text-ink-subtle">—</td>
            <td class="py-2.5 text-right font-mono text-xs text-ink-subtle">{orch.sg.tokensPerCall.toLocaleString()}</td>
          </tr>
          <tr class="border-b border-rule/40 hover:bg-rule/20">
            <td class="py-2.5 pr-4 font-mono text-xs font-semibold">Skill-Adjusted</td>
            <td class="py-2.5 pr-4 text-xs text-ink-muted">Recognised as skill+gap?</td>
            <td class="py-2.5 pr-3 text-right font-mono text-xs text-ink-subtle">{orch.sa.cases}</td>
            <td class={`py-2.5 pr-3 text-right font-mono font-bold text-base ${orch.sa.routingAcc >= 0.7 ? "text-green-700" : "text-red-500"}`}>
              {orch.sa.routingAcc.toFixed(3)}
            </td>
            <td class={`py-2.5 pr-3 text-right font-mono text-sm ${orch.sa.skillAcc >= 0.7 ? "text-green-700 font-semibold" : "text-red-500"}`}>
              {orch.sa.skillAcc.toFixed(3)}
            </td>
            <td class={`py-2.5 pr-3 text-right font-mono text-sm ${orch.sa.gapFoundRate >= 0.7 ? "text-green-700 font-semibold" : "text-ink-muted"}`}>
              {orch.sa.gapFoundRate.toFixed(3)}
            </td>
            <td class={`py-2.5 pr-3 text-right font-mono text-sm ${orch.sa.gapCountAcc >= 0.5 ? "text-green-700 font-semibold" : "text-red-500"}`}>
              {orch.sa.gapCountAcc.toFixed(3)}
            </td>
            <td class="py-2.5 pr-3 text-right font-mono text-xs text-ink-subtle">—</td>
            <td class="py-2.5 text-right font-mono text-xs text-ink-subtle">{orch.sa.tokensPerCase.toLocaleString()}</td>
          </tr>
          <tr class="border-b border-rule/40 hover:bg-rule/20">
            <td class="py-2.5 pr-4 font-mono text-xs font-semibold">Dynamic</td>
            <td class="py-2.5 pr-4 text-xs text-ink-muted">Correctly stayed ad-hoc?</td>
            <td class="py-2.5 pr-3 text-right font-mono text-xs text-ink-subtle">{orch.dy.cases}</td>
            <td class={`py-2.5 pr-3 text-right font-mono font-bold text-base ${orch.dy.routingAcc >= 0.7 ? "text-green-700" : "text-red-500"}`}>
              {orch.dy.routingAcc.toFixed(3)}
            </td>
            <td class="py-2.5 pr-3 text-right font-mono text-xs text-ink-subtle">—</td>
            <td class="py-2.5 pr-3 text-right font-mono text-xs text-ink-subtle">—</td>
            <td class="py-2.5 pr-3 text-right font-mono text-xs text-ink-subtle">—</td>
            <td class="py-2.5 pr-3 text-right font-mono text-sm">
              {orch.dy.decompAcc != null ? (
                <span class={`font-bold ${orch.dy.decompAcc >= 0.6 ? "text-green-700" : orch.dy.decompAcc >= 0.4 ? "text-yellow-600" : "text-red-500"}`}>
                  {orch.dy.decompAcc.toFixed(3)}
                </span>
              ) : "—"}
            </td>
            <td class="py-2.5 text-right font-mono text-xs text-ink-subtle">{orch.dy.tokensPerCase.toLocaleString()}</td>
          </tr>
        </tbody>
      </table>
      <p class="text-[10px] font-mono text-ink-subtle mt-2">
        Routing-Acc is mode detection for all three rows (was the case routed to the right mode?). Skill-Acc is whether the resolver picked the correct skill id, measured hint-free for SG and SA (DY has no skill). SG runs end-to-end on the 30 canonical benchmark prompts, reference condition {orch.sg.ref} (routing is method/state-independent since SG bypasses retrieval). Decomp-Acc = green verdicts / {orch.dy.decompTally.total} cases (green {orch.dy.decompTally.green} · yellow {orch.dy.decompTally.yellow} · red {orch.dy.decompTally.red}). Gap-Found / Gap-Count-Acc measure the planner on the 20 skill-adjusted cases.
      </p>
    </div>

    {/* SG mode-detection traces */}
    {orch.sgCases.length > 0 && (
      <div class="mb-10">
        <h3 class="font-mono text-xs uppercase tracking-wider text-ink-subtle mb-3">Skill-Guided — end-to-end traces ({orch.sgCases.length} cases, ref {orch.sg.ref}): mode + skill</h3>
        <div class="flex flex-wrap gap-1.5 mb-4" id="sg-trace-btns">
          {orch.sgCases.map((c: any, i: number) => (
            <button
              data-sg-trace={i}
              class={"sg-trace-btn font-mono text-[10px] px-2 py-1 rounded border transition " + (c.mode_routing_ok && c.skill_routing_ok ? "border-green-300 bg-green-50 text-green-700" : c.mode_routing_ok || c.skill_routing_ok ? "border-yellow-300 bg-yellow-50 text-yellow-700" : "border-red-200 bg-red-50/50 text-red-700") + (i === 0 ? " ring-1 ring-accent" : "")}
            >
              {c.case_id} M{c.mode_routing_ok ? "✓" : "✗"} S{c.skill_routing_ok ? "✓" : "✗"}
            </button>
          ))}
        </div>
        <div id="sg-trace-detail" class="rounded-lg border border-rule p-4 text-xs">
          <p class="text-ink-subtle font-mono text-[10px]">Select a case above</p>
        </div>
      </div>
    )}

    {/* SA routing/gap traces */}
    {orch.saRouting.length > 0 && (
      <div class="mb-10">
        <h3 class="font-mono text-xs uppercase tracking-wider text-ink-subtle mb-3">Skill-Adjusted — gap-detection traces ({orch.saRouting.length} cases)</h3>
        <div class="flex flex-wrap gap-1.5 mb-4" id="sa-routing-btns">
          {orch.saRouting.map((c: any, i: number) => {
            const exact = c.predicted_gap_count === c.expected_gap_count && c.predicted_gap_count > 0;
            const partial = c.predicted_gap_count > 0 && !exact;
            const cls = exact ? "border-green-300 bg-green-50 text-green-700"
              : partial ? "border-yellow-300 bg-yellow-50 text-yellow-700"
              : "border-red-200 bg-red-50/50 text-red-700";
            const icon = exact ? "✓" : partial ? "~" : "✗";
            return (
              <button
                data-sa-routing-trace={i}
                class={"sa-routing-btn font-mono text-[10px] px-2 py-1 rounded border transition " + cls + (i === 0 ? " ring-1 ring-accent" : "")}
              >
                {c.case_id} S{c.skill_routing_ok ? "✓" : "✗"} {icon}
              </button>
            );
          })}
        </div>
        <div id="sa-routing-detail" class="rounded-lg border border-rule p-4 text-xs">
          <p class="text-ink-subtle font-mono text-[10px]">Select a case above</p>
        </div>
      </div>
    )}

    {/* DY routing + decomposer traces */}
    {orch.dyRouting.length > 0 && (
      <div>
        <h3 class="font-mono text-xs uppercase tracking-wider text-ink-subtle mb-3">Dynamic — routing + decomposer traces ({orch.dyRouting.length} cases)</h3>
        <div class="flex flex-wrap gap-1.5 mb-4" id="dy-routing-btns">
          {orch.dyRouting.map((c: any, i: number) => {
            const verdict = c.decomp?.verdict ?? null;
            const bothOk = c.routing_ok && verdict === "green";
            const oneOk = c.routing_ok || (verdict && verdict !== "red");
            const btnColor = bothOk
              ? "border-green-300 bg-green-50 text-green-700"
              : oneOk
              ? "border-yellow-300 bg-yellow-50 text-yellow-700"
              : "border-red-200 bg-red-50/50 text-red-700";
            const icon = bothOk ? "✓" : oneOk ? "~" : "✗";
            return (
              <button
                data-dy-routing-trace={i}
                class={"dy-routing-btn font-mono text-[10px] px-2 py-1 rounded border transition " + btnColor + (i === 0 ? " ring-1 ring-accent" : "")}
              >
                {c.case_id} {icon}
              </button>
            );
          })}
        </div>
        <div id="dy-routing-detail" class="rounded-lg border border-rule p-4 text-xs">
          <p class="text-ink-subtle font-mono text-[10px]">Select a case above</p>
        </div>
      </div>
    )}
  </section>
  </div>  {/* end orchestration panel */}

  {/* ═══════════ RETRIEVAL ═══════════ */}
  <div data-panel="retrieval" class="res-panel hidden">
  <section>
    <h2 class="font-serif text-xl font-semibold mb-1">Retrieval</h2>
    <p class="text-xs text-ink-muted mb-6 max-w-2xl">
      Isolated retrieval per method × ORD state — the router is bypassed so every method sees the same query set. Clean-ORD (0) vs. Enriched-ORD (1).
    </p>

    <!-- Retrieval sub-tabs -->
    <div class="flex gap-0 mb-6 border-b border-rule">
      {([
        { id: "dt",  label: "Design-Time" },
        { id: "sg",  label: "Skill-Guided" },
        { id: "sa",  label: "Skill-Adjusted" },
        { id: "dy",  label: "Dynamic" },
        { id: "oos", label: "Out-of-Scope" },
      ] as const).map((t, i) => (
        <button data-submode={t.id} class={`sub-tab px-4 py-2 text-sm font-medium border-b-2 -mb-px transition-colors ${i === 0 ? "border-accent text-ink" : "border-transparent text-ink-subtle"}`}>
          {t.label}
        </button>
      ))}
    </div>

    {/* ── DESIGN-TIME ── */}
    <div data-subpanel="dt" class="sub-panel">
      <p class="text-xs text-ink-muted mb-6 max-w-2xl">
        Activity → Resource · Clean-ORD only · {status.dtPerMethod} cases per method · 30 process models (15 BPMN + 15 CMMN)
      </p>
      {dtResults.length > 0 ? (
        <div>
          <div class="overflow-x-auto mb-8">
            <table class="w-full text-sm border-collapse">
              <thead>
                <tr class="border-b-2 border-rule text-xs font-mono uppercase tracking-wider text-ink-subtle">
                  <th class="text-left py-2 pr-4">Method</th>
                  <th class="text-left py-2 pr-4 hidden sm:table-cell">Description</th>
                  <th class="text-right py-2 pr-3">n</th>
                  <th class="text-right py-2 pr-3 text-ink">P@1</th>
                  <th class="text-right py-2 pr-3">P@1 GT</th>
                  <th class="text-right py-2 pr-3">P@1 non-GT</th>
                  <th class="text-right py-2 pr-3">R@5</th>
                  <th class="text-right py-2 pr-3">R@5 GT</th>
                  <th class="text-right py-2 pr-3">R@5 non-GT</th>
                  <th class="text-right py-2 pr-3">MRR</th>
                  <th class="text-right py-2">Tokens/case</th>
                </tr>
              </thead>
              <tbody>
                {METHODS.map((m) => {
                  const r = dtResults.find((x: any) => x.method === m);
                  if (!r) return null;
                  const isBest = (r["P@1"] ?? 0) === bestDtP1 && m !== "S";
                  const r5meaningful = m !== "E";
                  return (
                    <tr class={`border-b border-rule/50 hover:bg-rule/20 ${m === "S" ? "opacity-70" : ""}`}>
                      <td class="py-2.5 pr-4 font-semibold font-mono">{m}</td>
                      <td class="py-2.5 pr-4 text-xs text-ink-muted hidden sm:table-cell">{METHOD_DESC[m]}</td>
                      <td class="py-2.5 pr-3 text-right font-mono text-xs text-ink-subtle">{r.cases}</td>
                      <td class={`py-2.5 pr-3 text-right font-mono font-bold ${isBest ? "text-green-700 text-base" : "text-sm"}`}>
                        {r["P@1"] != null ? r["P@1"].toFixed(3) : "—"}
                      </td>
                      <td class="py-2.5 pr-3 text-right font-mono text-sm text-ink-muted">{r["P@1_gt"] != null ? r["P@1_gt"].toFixed(3) : "—"}</td>
                      <td class="py-2.5 pr-3 text-right font-mono text-sm text-ink-muted">{r["P@1_ngt"] != null ? r["P@1_ngt"].toFixed(3) : "—"}</td>
                      <td class="py-2.5 pr-3 text-right font-mono text-sm">
                        {r5meaningful ? (r["R@5"] != null ? r["R@5"].toFixed(3) : "—") : <span class="text-ink-subtle text-[10px]">= P@1</span>}
                      </td>
                      <td class="py-2.5 pr-3 text-right font-mono text-sm text-ink-muted">
                        {r5meaningful ? (r["R@5_gt"] != null ? r["R@5_gt"].toFixed(3) : "—") : <span class="text-ink-subtle text-[10px]">= P@1 GT</span>}
                      </td>
                      <td class="py-2.5 pr-3 text-right font-mono text-sm text-ink-muted">
                        {r5meaningful ? (r["R@5_ngt"] != null ? r["R@5_ngt"].toFixed(3) : "—") : <span class="text-ink-subtle text-[10px]">= P@1 non-GT</span>}
                      </td>
                      <td class="py-2.5 pr-3 text-right font-mono text-sm">{r["MRR"] != null ? r["MRR"].toFixed(3) : "—"}</td>
                      <td class="py-2.5 text-right font-mono text-xs text-ink-subtle">
                        {r.avg_tokens_per_case != null ? Math.round(r.avg_tokens_per_case).toLocaleString() : "—"}
                      </td>
                    </tr>
                  );
                })}
              </tbody>
            </table>
            <p class="text-[10px] font-mono text-ink-subtle mt-2">
              Best non-baseline in bold. Method S = Baseline-Solver (no retrieval, single LLM call). Method E R@5 ≡ P@1 by design: the filesystem agent commits to a single pick.
            </p>
          </div>

          {/* BPMN vs CMMN split */}
          {dtByModel.length > 0 && (
            <div class="mb-8">
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                {(["BPMN", "CMMN"] as const).map((notation) => {
                  const rows = dtByModel.filter((r: any) => r.notation === notation);
                  if (!rows.length) return null;
                  const bestP1 = Math.max(...rows.filter((r: any) => r.method !== "S").map((r: any) => r["P@1"] ?? 0));
                  return (
                    <div class="border border-rule rounded-xl overflow-hidden">
                      <button class="notation-toggle w-full flex items-center justify-between px-5 py-3.5 bg-paper hover:bg-rule/30 transition text-left" data-notation={notation}>
                        <div class="flex items-center gap-3">
                          <span class="font-mono text-[10px] text-ink-subtle toggle-arrow">▸</span>
                          <span class="font-serif text-base font-semibold">{notation}</span>
                          <span class="text-[10px] font-mono text-ink-subtle">{notation === "BPMN" ? "structured flows" : "knowledge-intensive cases"}</span>
                        </div>
                        <span class="font-mono text-xs text-ink-subtle">{rows[0]?.cases} cases · best P@1 {bestP1.toFixed(3)}</span>
                      </button>
                      <div class="notation-panel hidden border-t border-rule">
                        <div class="overflow-x-auto">
                          <table class="w-full text-sm border-collapse">
                            <thead>
                              <tr class="border-b-2 border-rule text-xs font-mono uppercase tracking-wider text-ink-subtle">
                                <th class="text-left py-2 px-5">Method</th>
                                <th class="text-left py-2 pr-4 hidden sm:table-cell">Description</th>
                                <th class="text-right py-2 pr-3">n</th>
                                <th class="text-right py-2 pr-3 text-ink">P@1</th>
                                <th class="text-right py-2 pr-3">R@5</th>
                                <th class="text-right py-2 pr-5">MRR</th>
                              </tr>
                            </thead>
                            <tbody>
                              {METHODS.map((m) => {
                                const r = rows.find((x: any) => x.method === m);
                                if (!r) return null;
                                const isBest = (r["P@1"] ?? 0) === bestP1 && m !== "S";
                                const r5meaningful = m !== "E";
                                return (
                                  <tr class={`border-b border-rule/50 hover:bg-rule/20 ${m === "S" ? "opacity-70" : ""}`}>
                                    <td class="py-2.5 pl-5 pr-4 font-semibold font-mono">{m}</td>
                                    <td class="py-2.5 pr-4 text-xs text-ink-muted hidden sm:table-cell">{METHOD_DESC[m]}</td>
                                    <td class="py-2.5 pr-3 text-right font-mono text-xs text-ink-subtle">{r.cases}</td>
                                    <td class={`py-2.5 pr-3 text-right font-mono font-bold ${isBest ? "text-green-700 text-base" : "text-sm"}`}>
                                      {r["P@1"] != null ? r["P@1"].toFixed(3) : "—"}
                                    </td>
                                    <td class="py-2.5 pr-3 text-right font-mono text-sm">
                                      {r5meaningful ? (r["R@5"] != null ? r["R@5"].toFixed(3) : "—") : <span class="text-ink-subtle text-[10px]">= P@1</span>}
                                    </td>
                                    <td class="py-2.5 pr-5 text-right font-mono text-sm">{r["MRR"] != null ? r["MRR"].toFixed(3) : "—"}</td>
                                  </tr>
                                );
                              })}
                            </tbody>
                          </table>
                        </div>
                      </div>
                    </div>
                  );
                })}
              </div>
            </div>
          )}

          {/* Per-process breakdown */}
          {procList.length > 0 && (
            <div>
              <h3 class="font-mono text-xs uppercase tracking-wider text-ink-subtle mb-3">Per-process breakdown — click a row to see step details</h3>
              <div class="space-y-1" id="proc-breakdown">
                {procList.map(([proc, byMethod]) => {
                  const traces = loadProcessTraces(proc);
                  const traceJson = JSON.stringify(traces);
                  return (
                    <div class="border border-rule rounded-lg overflow-hidden">
                      <button class="proc-row w-full flex items-center gap-3 px-4 py-2.5 hover:bg-rule/30 transition text-left" data-traces={traceJson} data-proc={proc}>
                        <span class="font-mono text-[10px] text-ink-subtle w-4 shrink-0">▸</span>
                        <a href={`${base}processes/${proc}/`} class="font-mono text-xs text-accent-ink hover:underline shrink-0" onclick="event.stopPropagation()">{proc}</a>
                        <div class="flex gap-3 ml-2 flex-wrap">
                          {METHODS.map((m) => {
                            const r = (byMethod as any)[m];
                            const v = r?.["P@1"];
                            return (
                              <span class={`font-mono text-[10px] ${v != null && v >= 0.5 ? "text-green-700 font-semibold" : v != null && v === 0 ? "text-red-500" : "text-ink-subtle"}`}>
                                {m}:{v != null ? v.toFixed(2) : "—"}
                              </span>
                            );
                          })}
                        </div>
                      </button>
                      <div class="proc-detail hidden px-4 pb-4 pt-2 border-t border-rule/50 bg-rule/10">
                        <p class="font-mono text-[10px] text-ink-subtle mb-3">Step traces — label, prediction, correct?</p>
                        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-3" id={`detail-${proc}`}></div>
                      </div>
                    </div>
                  );
                })}
              </div>
            </div>
          )}
        </div>
      ) : (
        <div class="border border-rule rounded-lg p-6 text-center bg-rule/20">
          <p class="text-sm text-ink-muted">No design-time results yet.</p>
        </div>
      )}
    </div>

    {/* ── SKILL-GUIDED (skill selection) ── */}
    <div data-subpanel="sg" class="sub-panel hidden">
      <p class="text-xs text-ink-muted mb-5 max-w-2xl">
        Skill-selection test — given a skill-guided prompt, did the resolver pick the correct skill from the library? Method-independent (the resolver ranks over the skill catalogue, not the retrieval backend), so this is a single evaluation over {sgRet.summary.cases} cases.
      </p>
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 mb-6 font-mono">
        <div class="rounded-lg border border-rule p-3">
          <div class="text-[10px] uppercase tracking-wider text-ink-subtle mb-1">Skill-Acc</div>
          <div class={`text-lg font-bold ${sgRet.summary.routingAcc >= 0.7 ? "text-green-700" : "text-red-500"}`}>{sgRet.summary.routingAcc.toFixed(3)}</div>
        </div>
        <div class="rounded-lg border border-rule p-3">
          <div class="text-[10px] uppercase tracking-wider text-ink-subtle mb-1">Correct</div>
          <div class="text-lg font-bold text-ink">{sgRet.summary.correct} / {sgRet.summary.cases}</div>
        </div>
        <div class="rounded-lg border border-rule p-3">
          <div class="text-[10px] uppercase tracking-wider text-ink-subtle mb-1">Cases</div>
          <div class="text-lg font-bold text-ink">{sgRet.summary.cases}</div>
        </div>
        <div class="rounded-lg border border-rule p-3">
          <div class="text-[10px] uppercase tracking-wider text-ink-subtle mb-1">Tokens/case</div>
          <div class="text-lg font-bold text-ink-muted">{sgRet.summary.tokensPerCase.toLocaleString()}</div>
        </div>
      </div>

      {sgRet.cases.length > 0 ? (
        <div>
          <h3 class="font-mono text-xs uppercase tracking-wider text-ink-subtle mb-3">Traces — {sgRet.cases.length} cases</h3>
          <div class="flex flex-wrap gap-1.5 mb-4" id="sg-skill-btns">
            {sgRet.cases.map((c: any, i: number) => (
              <button
                data-sg-skill={i}
                class={"sg-skill-btn font-mono text-[10px] px-2 py-1 rounded border transition " + (c.routing_ok ? "border-green-300 bg-green-50 text-green-700" : "border-red-200 bg-red-50/50 text-red-700") + (i === 0 ? " ring-1 ring-accent" : "")}
              >
                {c.case_id} {c.routing_ok ? "✓" : "✗"}
              </button>
            ))}
          </div>
          <div id="sg-skill-detail" class="rounded-lg border border-rule p-4 text-xs">
            <p class="text-ink-subtle font-mono text-[10px]">Select a case above</p>
          </div>
        </div>
      ) : <p class="text-sm text-ink-muted">No results yet.</p>}
    </div>

    {/* ── SKILL-ADJUSTED ── */}
    <div data-subpanel="sa" class="sub-panel hidden">
      <p class="text-xs text-ink-muted mb-5 max-w-2xl">
        The skill is provided (routing is measured under Orchestration). Here: did the retrieval method find the right resource for each coverage gap? Top-1/Top-5 are averaged over the expected gap ordIds per case.
      </p>
      {sa.rows.length > 0 ? (
        <div class="overflow-x-auto mb-8">
          <table class="w-full text-sm border-collapse">
            <thead>
              <tr class="border-b-2 border-rule text-xs font-mono uppercase tracking-wider text-ink-subtle">
                <th class="text-left py-2 pr-3">Cond</th>
                <th class="text-left py-2 pr-4 hidden sm:table-cell">Method</th>
                <th class="text-left py-2 pr-3">State</th>
                <th class="text-right py-2 pr-3">n</th>
                <th class="text-right py-2 pr-3 text-ink">Top-1</th>
                <th class="text-right py-2 pr-3">Top-5</th>
                <th class="text-right py-2 pr-3">n(gap)</th>
                <th class="text-right py-2 pr-3">Top-1(gap)</th>
                <th class="text-right py-2 pr-3">Top-5(gap)</th>
                <th class="text-right py-2">Tokens/case</th>
              </tr>
            </thead>
            <tbody>
              {sa.rows.map((r: any) => (
                <tr class={`border-b border-rule/40 hover:bg-rule/20 ${r.state === "enriched" ? "bg-blue-50/20" : ""}`}>
                  <td class="py-2 pr-3 font-mono text-xs font-semibold">{r.cond}</td>
                  <td class="py-2 pr-4 text-xs text-ink-muted hidden sm:table-cell">{METHOD_DESC[r.method]}</td>
                  <td class="py-2 pr-3 font-mono text-[10px] text-ink-subtle">{r.state === "clean" ? "0" : "1"}</td>
                  <td class="py-2 pr-3 text-right font-mono text-xs text-ink-subtle">{r.n}</td>
                  <td class={`py-2 pr-3 text-right font-mono font-bold ${r.top1 >= 0.3 ? "text-green-700" : r.top1 < 0.1 ? "text-red-500" : ""}`}>{r.top1.toFixed(3)}</td>
                  <td class="py-2 pr-3 text-right font-mono text-sm">{r.top5.toFixed(3)}</td>
                  <td class="py-2 pr-3 text-right font-mono text-xs text-ink-subtle">{r.nGap}</td>
                  <td class="py-2 pr-3 text-right font-mono text-sm text-ink-muted">{r.top1Gap != null ? r.top1Gap.toFixed(3) : "—"}</td>
                  <td class="py-2 pr-3 text-right font-mono text-sm text-ink-muted">{r.top5Gap != null ? r.top5Gap.toFixed(3) : "—"}</td>
                  <td class="py-2 text-right font-mono text-xs text-ink-subtle">{r.tokensPerCase.toLocaleString()}</td>
                </tr>
              ))}
            </tbody>
          </table>
          <p class="text-[10px] font-mono text-ink-subtle mt-2">0 = clean-ORD · 1 = enriched-ORD · blue rows = enriched. n(gap) = cases with a planner-produced gap step; Top-1(gap)/Top-5(gap) restrict to those.</p>
        </div>
      ) : <p class="text-sm text-ink-muted mb-8">No results yet.</p>}

      <div>
        <h3 class="font-mono text-xs uppercase tracking-wider text-ink-subtle mb-3">Traces — select method and state</h3>
        <div class="flex flex-wrap gap-2 mb-4">
          {METHODS.flatMap(m => ["0","1"].map(st => {
            const key = m + st;
            const traces = sa.tracesByCond[key] ?? [];
            const label = `${m} · ${st === "0" ? "Clean" : "Enrich"}`;
            return (
              <button data-sa-ms={key} class={"sa-ms-btn font-mono text-[10px] px-3 py-1.5 rounded border transition hover:border-accent " + (key === "A0" ? "border-accent bg-accent-soft/40 text-accent-ink" : "border-rule bg-paper text-ink-muted")}>
                {label}<span class="ml-1 text-[9px] opacity-60">{traces.length}</span>
              </button>
            );
          }))}
        </div>
        <div class="flex flex-wrap gap-1.5 mb-4" id="sa-ms-case-btns"></div>
        <div id="sa-ms-trace-detail" class="rounded-lg border border-rule p-4 text-xs">
          <p class="text-ink-subtle font-mono text-[10px]">Select a method above, then a case to inspect</p>
        </div>
      </div>
    </div>

    {/* ── DYNAMIC ── */}
    <div data-subpanel="dy" class="sub-panel hidden">
      <p class="text-xs text-ink-muted mb-5 max-w-2xl">
        Ad-hoc retrieval — no matching skill. Single-intent cases (dy-01..20) run one retrieval; multi-intent cases (dy-21..40) are decomposed into sub-queries and scored with partial credit. Combined Top-1 averages over all 40 cases.
      </p>
      {dy.rows.length > 0 ? (
        <div class="overflow-x-auto mb-8">
          <table class="w-full text-sm border-collapse">
            <thead>
              <tr class="border-b-2 border-rule text-xs font-mono uppercase tracking-wider text-ink-subtle">
                <th class="text-left py-2 pr-3">Cond</th>
                <th class="text-left py-2 pr-4 hidden sm:table-cell">Method</th>
                <th class="text-left py-2 pr-3">State</th>
                <th class="text-right py-2 pr-3">n</th>
                <th class="text-right py-2 pr-3 text-ink">Top-1 [95% CI]</th>
                <th class="text-right py-2 pr-3">Top-5</th>
                <th class="text-right py-2 pr-3">Top-1 single</th>
                <th class="text-right py-2 pr-3">Top-1 multi</th>
                <th class="text-right py-2 pr-3" title="Both sub-query GTs recalled in top-5 (multi-intent)">Recall-all multi</th>
                <th class="text-right py-2">Tokens/case</th>
              </tr>
            </thead>
            <tbody>
              {dy.rows.map((r: any) => (
                <tr class={`border-b border-rule/40 hover:bg-rule/20 ${r.state === "enriched" ? "bg-blue-50/20" : ""}`}>
                  <td class="py-2 pr-3 font-mono text-xs font-semibold">{r.cond}</td>
                  <td class="py-2 pr-4 text-xs text-ink-muted hidden sm:table-cell">{METHOD_DESC[r.method]}</td>
                  <td class="py-2 pr-3 font-mono text-[10px] text-ink-subtle">{r.state === "clean" ? "0" : "1"}</td>
                  <td class="py-2 pr-3 text-right font-mono text-xs text-ink-subtle">{r.n}</td>
                  <td class={`py-2 pr-3 text-right font-mono font-bold ${r.top1 >= 0.4 ? "text-green-700" : r.top1 < 0.1 ? "text-red-500" : ""}`}>
                    {r.top1.toFixed(3)}
                    <span class="block text-[9px] text-ink-subtle font-normal">[{r.top1CIlo.toFixed(2)}, {r.top1CIhi.toFixed(2)}]</span>
                  </td>
                  <td class="py-2 pr-3 text-right font-mono text-sm">{r.top5.toFixed(3)}</td>
                  <td class="py-2 pr-3 text-right font-mono text-sm text-ink-muted">{r.top1Single != null ? r.top1Single.toFixed(3) : "—"}</td>
                  <td class="py-2 pr-3 text-right font-mono text-sm text-ink-muted">{r.top1Multi != null ? r.top1Multi.toFixed(3) : "—"}</td>
                  <td class="py-2 pr-3 text-right font-mono text-sm text-purple-700">{r.recallAllMulti != null ? r.recallAllMulti.toFixed(3) : "—"}</td>
                  <td class="py-2 text-right font-mono text-xs text-ink-subtle">{r.tokensPerCase.toLocaleString()}</td>
                </tr>
              ))}
            </tbody>
          </table>
          <p class="text-[10px] font-mono text-ink-subtle mt-2">
            Combined Top-1 over 40 cases (singles + partial-credit multi). 95% CI = Wilson interval on k = round(Σcredit), n = 40 (approximate for the blended value). Top-1 single (n=20) and Top-1 multi (mean partial credit, n=20 cases) split by query class. Recall-all multi = fraction of multi cases with both sub-query GTs in top-5.
          </p>
        </div>
      ) : <p class="text-sm text-ink-muted mb-8">No results yet.</p>}

      {/* Termination — agentic methods */}
      {termRows.length > 0 && (
        <div class="mb-8 border border-rule rounded-lg p-4 bg-paper">
          <div class="font-mono text-[10px] uppercase tracking-wider text-ink-subtle mb-3">Termination — agentic methods (D, E, F)</div>
          <table class="w-full text-xs">
            <thead>
              <tr class="border-b border-rule text-[10px] font-mono uppercase tracking-wider text-ink-subtle">
                <th class="text-left py-1 pr-3">Cond</th>
                <th class="text-right py-1 pr-3 text-green-700">picked</th>
                <th class="text-right py-1 pr-3 text-blue-700">refused</th>
                <th class="text-right py-1 pr-3 text-orange-600">budget exhausted</th>
                <th class="text-right py-1 pr-1 text-ink-subtle">total</th>
              </tr>
            </thead>
            <tbody>
              {termRows.map((v: any) => (
                <tr class="border-b border-rule/40">
                  <td class="py-1 pr-3 font-mono">{v.cond}</td>
                  <td class="py-1 pr-3 text-right font-mono text-green-700">{v.picked}</td>
                  <td class="py-1 pr-3 text-right font-mono text-blue-700">{v.refused}</td>
                  <td class="py-1 pr-3 text-right font-mono text-orange-600">{v.budget_exhausted}</td>
                  <td class="py-1 pr-1 text-right font-mono text-ink-subtle">{v.total}</td>
                </tr>
              ))}
            </tbody>
          </table>
          <p class="text-[10px] font-mono text-ink-subtle mt-2">
            Budget exhausted = the agent ran out of tool calls without an explicit pick or refuse, counted as no candidate in Top-1. Over all 60 retrieval units per condition (20 singles + 40 sub-queries).
          </p>
        </div>
      )}

      {/* DY trace viewer */}
      <div class="mt-8">
        <h3 class="font-mono text-xs uppercase tracking-wider text-ink-subtle mb-3">Traces — select method and state</h3>
        <div class="flex flex-wrap gap-2 mb-4" id="dy-method-state-btns">
          {METHODS.map((m) => (
            <>
              <button data-dy-ms={m + "0"} class={"dy-ms-btn font-mono text-[10px] px-2.5 py-1 rounded border transition " + (m === "A" ? "border-accent bg-accent/10 text-ink" : "border-rule text-ink-subtle hover:bg-rule/30")}>
                {m} · Clean
              </button>
              <button data-dy-ms={m + "1"} class="dy-ms-btn font-mono text-[10px] px-2.5 py-1 rounded border border-rule text-ink-subtle hover:bg-rule/30 transition">
                {m} · Enrich
              </button>
            </>
          ))}
        </div>
        <div class="flex flex-wrap gap-1.5 mb-4" id="dy-trace-btns"></div>
        <div id="dy-trace-detail" class="rounded-lg border border-rule p-4 text-xs">
          <p class="text-ink-subtle font-mono text-[10px]">Select a method+state above, then a case</p>
        </div>
      </div>
    </div>

    {/* ── OUT-OF-SCOPE ── */}
    <div data-subpanel="oos" class="sub-panel hidden">
      <p class="text-xs text-ink-muted mb-4 max-w-2xl">
        Refusal test — no resource in the landscape matches. Refusal-Rate is the primary metric; False-Pick-Rate counts cases where the method returned something anyway.
      </p>
      {oos.rows.length > 0 ? (
        <div class="overflow-x-auto mb-8">
          <table class="w-full text-sm border-collapse">
            <thead>
              <tr class="border-b-2 border-rule text-xs font-mono uppercase tracking-wider text-ink-subtle">
                <th class="text-left py-2 pr-3">Cond</th>
                <th class="text-left py-2 pr-4 hidden sm:table-cell">Method</th>
                <th class="text-left py-2 pr-4 hidden md:table-cell">State</th>
                <th class="text-right py-2 pr-3">n</th>
                <th class="text-right py-2 pr-3 text-ink">Refusal-Rate</th>
                <th class="text-right py-2 pr-3">False-Pick-Rate</th>
                <th class="text-right py-2">Tokens/case</th>
              </tr>
            </thead>
            <tbody>
              {oos.rows.map((r: any) => (
                <tr class={`border-b border-rule/40 hover:bg-rule/20 ${r.state === "enriched" ? "bg-blue-50/20" : ""}`}>
                  <td class="py-2 pr-3 font-mono text-xs font-semibold">{r.cond}</td>
                  <td class="py-2 pr-4 text-xs text-ink-muted hidden sm:table-cell">{METHOD_DESC[r.method]}</td>
                  <td class="py-2 pr-4 font-mono text-[10px] text-ink-subtle hidden md:table-cell">{r.state === "clean" ? "0" : "1"}</td>
                  <td class="py-2 pr-3 text-right font-mono text-xs text-ink-subtle">{r.n}</td>
                  <td class={`py-2 pr-3 text-right font-mono text-sm ${r.refusalRate >= 0.7 ? "text-green-700 font-bold" : r.refusalRate < 0.3 ? "text-red-500" : ""}`}>{r.refusalRate.toFixed(3)}</td>
                  <td class="py-2 pr-3 text-right font-mono text-sm text-ink-muted">{r.falsePickRate.toFixed(3)}</td>
                  <td class="py-2 text-right font-mono text-xs text-ink-subtle">{r.tokensPerCase.toLocaleString()}</td>
                </tr>
              ))}
            </tbody>
          </table>
          <p class="text-[10px] font-mono text-ink-subtle mt-2">0 = clean-ORD · 1 = enriched-ORD · blue rows = enriched. Refusal-Rate bold if ≥ 0.7.</p>
        </div>
      ) : <p class="text-sm text-ink-muted mb-8">No results yet.</p>}

      <div class="mt-4">
        <h3 class="font-mono text-xs uppercase tracking-wider text-ink-subtle mb-3">Traces — select method and state</h3>
        <div class="flex flex-wrap gap-2 mb-4">
          {METHODS.flatMap(m => ["0","1"].map(st => {
            const key = m + st;
            const count = (oos.tracesByCond[key] ?? []).length;
            const label = `${m} · ${st === "0" ? "Clean" : "Enrich"}`;
            return (
              <button data-oos-ms={key} class={"oos-ms-btn font-mono text-[10px] px-3 py-1.5 rounded border transition hover:border-accent " + (key === "A0" ? "border-accent bg-accent-soft/40 text-accent-ink" : "border-rule bg-paper text-ink-muted")}>
                {label}<span class="ml-1 text-[9px] opacity-60">{count}</span>
              </button>
            );
          }))}
        </div>
        <div class="flex flex-wrap gap-1.5 mb-4" id="oos-ms-case-btns"></div>
        <div id="oos-ms-trace-detail" class="rounded-lg border border-rule p-4 text-xs">
          <p class="text-ink-subtle font-mono text-[10px]">Select a method above, then a case to inspect</p>
        </div>
      </div>
    </div>
  </section>
  </div>  {/* end retrieval panel */}
</Base>

<script define:vars={{ _sg: orch.sgCases, _sgSkill: sgRet.cases, _saRouting: orch.saRouting, _dyRouting: orch.dyRouting, _base: base, _saAll: sa.tracesByCond, _dyAll: dy.tracesByCond, _oosAll: oos.tracesByCond }} is:inline>
  window.__sgTraces = _sg;
  window.__sgSkillCases = _sgSkill;
  window.__saRouting = _saRouting;
  window.__dyRouting = _dyRouting;
  window.__base = _base;
  window.__saAllTraces = _saAll;
  window.__dyAllTraces = _dyAll;
  window.__oosAllTraces = _oosAll;
</script>

<script>
  // ── Top tabs (Orchestration / Retrieval) ──────────────────────────────────
  const tabs = document.querySelectorAll<HTMLButtonElement>(".res-tab");
  const panels = document.querySelectorAll<HTMLElement>(".res-panel");
  function activate(id: string) {
    tabs.forEach((t) => {
      const on = t.dataset.tab === id;
      t.classList.toggle("border-accent", on);
      t.classList.toggle("text-ink", on);
      t.classList.toggle("border-transparent", !on);
      t.classList.toggle("text-ink-subtle", !on);
    });
    panels.forEach((p) => { p.classList.toggle("hidden", p.dataset.panel !== id); });
    sessionStorage.setItem("results-tab", id);
  }
  panels.forEach((p) => { if (p.dataset.panel !== "orchestration") p.classList.add("hidden"); });
  const knownTabs = new Set(Array.from(panels).map((p) => p.dataset.panel));
  const savedTab = sessionStorage.getItem("results-tab");
  if (savedTab && knownTabs.has(savedTab)) activate(savedTab);
  tabs.forEach((t) => t.addEventListener("click", () => activate(t.dataset.tab!)));

  // ── Retrieval sub-tabs (dt / sa / dy / oos) ───────────────────────────────
  const subTabs = document.querySelectorAll<HTMLButtonElement>(".sub-tab");
  const subPanels = document.querySelectorAll<HTMLElement>("[data-subpanel]");
  function activateSub(id: string) {
    subTabs.forEach((t) => {
      const on = t.dataset.submode === id;
      t.classList.toggle("border-accent", on);
      t.classList.toggle("text-ink", on);
      t.classList.toggle("border-transparent", !on);
      t.classList.toggle("text-ink-subtle", !on);
    });
    subPanels.forEach((p) => { p.classList.toggle("hidden", p.dataset.subpanel !== id); });
    sessionStorage.setItem("rt-sub-tab", id);
  }
  subPanels.forEach((p) => { if (p.dataset.subpanel !== "dt") p.classList.add("hidden"); });
  const knownSubs = new Set(Array.from(subPanels).map((p) => p.dataset.subpanel));
  const savedSub = sessionStorage.getItem("rt-sub-tab");
  if (savedSub && knownSubs.has(savedSub)) activateSub(savedSub);
  subTabs.forEach((t) => t.addEventListener("click", () => activateSub(t.dataset.submode!)));

  // ── BPMN / CMMN notation toggles ─────────────────────────────────────────
  document.querySelectorAll<HTMLElement>(".notation-toggle").forEach((btn) => {
    btn.addEventListener("click", () => {
      const panel = btn.nextElementSibling as HTMLElement;
      const arrow = btn.querySelector(".toggle-arrow")!;
      const isOpen = !panel.classList.contains("hidden");
