  function renderDyMsTrace(i: number, ms: string) {
    const traces = dyAllTr[ms] ?? [];
    const t = traces[i]; if (!t || !dyDetEl) return;
    const base2 = (window as any).__base ?? '/';
    const top1ok = t.top1_correct; const top5ok = t.top5_correct;
    const badge = top1ok ? '<span class="px-1.5 py-0.5 rounded bg-green-100 text-green-700">✓ top-1</span>'
