        ${!ok && c.skill_picked ? `<a href="${(window as any).__base}processes/${c.skill_picked}/" class="font-mono text-[10px] px-1.5 py-0.5 rounded bg-red-50 border border-red-200 text-red-700">${c.skill_picked}</a>` : ''}
        ${summaryBadge}
      </div>
      <p class="text-ink-muted text-[11px] mb-2 leading-relaxed">${c.user_prompt}</p>
